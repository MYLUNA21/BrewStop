@model ActivityViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Account Activity";

    string Label(string action) => action switch
    {
        "ProfileUpdated" => "Profile updated",
        "PasswordChanged" => "Password changed",
        "PasswordSet" => "Password set",
        "SignedOutAllDevices" => "Signed out of all devices",
        "NotificationsUpdated" => "Notification settings updated",
        "ExternalLogin" => "Signed in with Google",
        "ExternalLoginLinked" => "Google account linked",
        "UserRegistered" => "Account registered",
        "AccountDeleted" => "Account deleted",
        _ => action
    };
}

<div class="tw">
    <div class="mx-auto max-w-6xl px-4 pt-24 pb-16">
        <h1 class="font-serif text-3xl font-bold text-cream">My Account</h1>
        <p class="mt-1 text-sm text-neutral-400">Account settings</p>

        <div class="mt-8 grid gap-8 lg:grid-cols-3">
            <aside class="lg:col-span-1">
                <partial name="_AccountSettingsNav" />
            </aside>

            <section class="rounded-3xl bg-white p-6 shadow-sm sm:p-10 lg:col-span-2">
                <h2 class="font-serif text-2xl font-semibold text-[#1e3932]">Account Activity</h2>
                <p class="mt-1 text-sm text-gray-500">Your 20 most recent account events (UTC).</p>

                @if (Model.Entries.Count == 0)
                {
                    <p class="mt-6 rounded-xl bg-[#f9f9f9] px-4 py-6 text-center text-sm text-gray-500">No activity recorded yet.</p>
                }
                else
                {
                    <ul class="mt-4 divide-y divide-gray-100">
                        @foreach (var a in Model.Entries)
                        {
                            <li class="flex flex-wrap items-start justify-between gap-2 py-4">
                                <div class="min-w-0">
                                    <p class="text-sm font-semibold text-[#1e3932]">@Label(a.Action)</p>
                                    @if (!string.IsNullOrWhiteSpace(a.Details))
                                    {
                                        <p class="mt-0.5 break-words text-xs text-gray-500">@a.Details</p>
                                    }
                                </div>
                                <time datetime="@a.CreatedAtUtc.ToString("o")" class="shrink-0 text-xs text-gray-400">
                                    @a.CreatedAtUtc.ToString("MMM d, yyyy h:mm tt") UTC
                                </time>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
</div>