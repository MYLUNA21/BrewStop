@* Views/Account/ForgotPassword.cshtml *@
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}
<h1 class="text-xl font-semibold mb-4">Forgot password</h1>
<form asp-action="ForgotPassword" method="post" class="space-y-4">
    <div>
        <label asp-for="Email" class="block text-sm mb-1"></label>
        <input asp-for="Email" class="@ViewData["Input"]" />
        <span asp-validation-for="Email" class="text-xs text-red-400"></span>
    </div>
    <button type="submit" class="@ViewData["Btn"]">Send reset link</button>
</form>