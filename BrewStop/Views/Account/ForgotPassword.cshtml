@* Views/Account/ForgotPassword.cshtml *@
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}
<h1 class="text-xl font-semibold mb-2">Forgot your password?</h1>
<p class="mb-4 text-sm text-stone-400">Enter your registered email and we'll send you a 6-digit code to reset your password.</p>
<form asp-action="ForgotPassword" method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-400"></div>
    <div>
        <label asp-for="Email" class="block text-sm mb-1"></label>
        <input asp-for="Email" class="@ViewData["Input"]" autocomplete="email" />
        <span asp-validation-for="Email" class="text-xs text-red-400"></span>
    </div>
    <button type="submit" class="@ViewData["Btn"]">Send code</button>
    <p class="text-sm text-stone-400 text-center"><a asp-action="Login" class="hover:text-amber-400">Back to sign in</a></p>
</form>