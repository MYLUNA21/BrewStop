@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<h1 class="mb-6 text-center text-lg font-semibold">Sign in to your account</h1>

@if (TempData["Success"] is string ok)
{
    <div class="mb-4 rounded-lg border border-green-500/30 bg-green-500/10 p-3 text-sm text-green-300">@ok</div>
}

<form asp-action="Login" method="post" class="space-y-5">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-400"></div>

    <div>
        <div class="relative">
            <input asp-for="UserNameOrEmail" placeholder=" " autocomplete="username"
                   class="peer w-full rounded-md border border-stone-700 bg-stone-950 px-3 pb-2 pt-5 text-sm text-stone-100 focus:border-amber-500 focus:outline-none" />
            <label asp-for="UserNameOrEmail"
                   class="pointer-events-none absolute left-3 top-1.5 text-[11px] text-stone-400 transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-sm peer-focus:top-1.5 peer-focus:text-[11px] peer-focus:text-amber-500"></label>
        </div>
        <span asp-validation-for="UserNameOrEmail" class="text-xs text-red-400"></span>
    </div>

    <div>
        <div class="relative">
            <input asp-for="Password" placeholder=" " autocomplete="current-password"
                   class="peer w-full rounded-md border border-stone-700 bg-stone-950 py-0 pb-2 pl-3 pr-11 pt-5 text-sm text-stone-100 focus:border-amber-500 focus:outline-none" />
            <label asp-for="Password"
                   class="pointer-events-none absolute left-3 top-1.5 text-[11px] text-stone-400 transition-all peer-placeholder-shown:top-3.5 peer-placeholder-shown:text-sm peer-focus:top-1.5 peer-focus:text-[11px] peer-focus:text-amber-500"></label>
            <button type="button" id="pw-toggle" aria-label="Show password" aria-pressed="false"
                    class="absolute right-2 top-1/2 grid size-8 -translate-y-1/2 place-items-center rounded-full text-stone-400 transition hover:text-amber-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
                <svg id="pw-eye" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
                <svg id="pw-eye-off" class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M17.9 17.9A10.9 10.9 0 0 1 12 19C5.6 19 2 12 2 12a18.5 18.5 0 0 1 5.1-5.9M9.9 5.1A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7a18.6 18.6 0 0 1-2.2 3.2M1 1l22 22" />
                    <path d="M14.1 14.1a3 3 0 1 1-4.2-4.2" />
                </svg>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-xs text-red-400"></span>
    </div>

    <partial name="_Captcha" model="@("login")" />

    <div class="text-center">
        <a asp-action="ForgotPassword" class="text-sm font-semibold text-amber-500 hover:text-amber-400">Forgot your password?</a>
    </div>

    <div class="flex justify-end">
        <button type="submit"
                class="rounded-full bg-amber-500 px-8 py-2.5 text-sm font-semibold text-stone-950 transition hover:bg-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-300">
            Sign In
        </button>
    </div>
</form>

<div class="my-6 flex items-center gap-3 text-xs text-stone-500">
    <div class="h-px flex-1 bg-stone-700"></div>
    <span>or</span>
    <div class="h-px flex-1 bg-stone-700"></div>
</div>

<form asp-action="ExternalLogin" asp-controller="Account" method="post">
    <input type="hidden" name="provider" value="Google" />
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <button type="submit"
            class="w-full flex items-center justify-center gap-3 rounded-lg border border-stone-700 bg-stone-900 px-4 py-2.5 text-sm font-medium text-stone-100 transition hover:border-amber-500 hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-amber-500">
        <svg class="h-5 w-5" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z" />
            <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.6 5.9c4.4-4.1 7-10.1 7-17.6z" />
            <path fill="#FBBC05" d="M10.5 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.2.8-4.7l-7.9-6.1C.9 16.4 0 20.1 0 24s.9 7.6 2.6 10.8l7.9-6.1z" />
            <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z" />
        </svg>
        Continue with Google
    </button>
</form>

@section Below {
    <section class="mt-8 text-center">
        <h2 class="text-sm font-semibold text-amber-500">Not a member yet? Join BrewStop</h2>
        <p class="mx-auto mt-1 max-w-xs text-sm text-stone-400">Order ahead, skip the line, and earn rewards on every cup.</p>
        <a href="/Account/Register"
           class="mt-4 inline-block rounded-full border border-amber-500 px-7 py-2 text-sm font-semibold text-amber-500 transition hover:bg-amber-500 hover:text-stone-950">
            Join Now
        </a>
    </section>
}

@section Scripts {
    <script>
        (function() {
            var btn = document.getElementById('pw-toggle'), input = document.getElementById('Password');
            if (!btn || !input) return;
            btn.addEventListener('click', function() {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                document.getElementById('pw-eye').classList.toggle('hidden', show);
                document.getElementById('pw-eye-off').classList.toggle('hidden', !show);
            });
        })();
    </script>
}