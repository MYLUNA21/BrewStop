@* Views/Account/Login.cshtml *@
@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<h1 class="text-xl font-semibold mb-4">Sign in</h1>
<form asp-action="Login" method="post" class="space-y-4">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-400"></div>
    <div>
        <label asp-for="Email" class="block text-sm mb-1"></label>
        <input asp-for="Email" class="@ViewData["Input"]" autocomplete="username" />
        <span asp-validation-for="Email" class="text-xs text-red-400"></span>
    </div>
    <div>
        <label asp-for="Password" class="block text-sm mb-1"></label>
        <input asp-for="Password" class="@ViewData["Input"]" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-xs text-red-400"></span>
    </div>
    <button type="submit" class="@ViewData["Btn"]">Sign in</button>
    <div class="flex justify-between text-sm text-stone-400">
        <a asp-action="ForgotPassword" class="hover:text-amber-400">Forgot password?</a>
        <a asp-action="Register" class="hover:text-amber-400">Create account</a>
    </div>

    @if (ViewBag.NeedsVerification == true)
    {
        <form asp-action="ResendConfirmation" method="post" class="mt-4 text-sm">
            <input type="hidden" name="email" value="@Model.Email" />
            <button type="submit" class="text-amber-400 hover:underline">Resend verification email</button>
        </form>
    }

</form>