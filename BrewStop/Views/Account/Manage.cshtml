@model ManageViewModel
@model ManageProfileViewModel
@{
    Layout = "_Layout";   // overrides Account/_ViewStart (_AuthLayout)
    ViewData["Title"] = "My Account";
    const string label = "mb-1.5 block text-xs font-semibold uppercase tracking-wider text-neutral-300";
    const string field = "w-full rounded-xl border border-white/15 bg-transparent px-3 py-3 text-sm text-cream placeholder:text-neutral-500 focus:border-caramel focus:outline-none";
    const string err = "mt-1 block text-xs text-red-300";
    Layout = "_Layout";   
    ViewData["Title"] = "Personal Information";
    const string label = "mb-1 block text-xs font-semibold uppercase tracking-wider text-gray-500";
    const string field = "w-full border-0 border-b border-gray-300 bg-transparent px-0 py-2.5 text-sm text-[#1e3932] placeholder:text-gray-400 focus:border-[#00754a] focus:outline-none focus:ring-0";
    const string err = "mt-1 block text-xs text-[#d62b1f]";
    const string btn = "rounded-full bg-[#00754a] px-7 py-2.5 text-sm font-semibold text-white transition hover:bg-[#1e3932]";
}

<div class="tw">
    <div class="mx-auto max-w-3xl px-4 pt-24 pb-16">
    <div class="mx-auto max-w-6xl px-4 pt-24 pb-16">
        <h1 class="font-serif text-3xl font-bold text-cream">My Account</h1>
        <p class="mt-1 text-sm text-neutral-400">@Model.Email</p>

        <div class="mt-8 grid gap-8 lg:grid-cols-3">
            <aside class="lg:col-span-1">
                <partial name="_AccountSettingsNav" />
            </aside>

            <section class="rounded-3xl bg-white p-6 shadow-sm sm:p-10 lg:col-span-2">
                <h2 class="font-serif text-2xl font-semibold text-[#1e3932]">Personal Information</h2>
                <p class="mt-1 text-sm text-gray-500">Update your name, Campus ID, mobile number and profile photo.</p>

                @if (TempData["Success"] is string ok)
                {
            <p class="mt-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-sm text-emerald-300" role="status">@ok</p>
                    <p class="mt-5 rounded-xl border border-[#00754a]/20 bg-[#e8f3ee] px-4 py-3 text-sm text-[#1e3932]" role="status">@ok</p>
                }

                <form asp-action="Manage" method="post" enctype="multipart/form-data" class="mt-6 space-y-6">
                    <div asp-validation-summary="ModelOnly" class="text-sm text-[#d62b1f]"></div>

                    <div class="flex items-center gap-5">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" alt="Profile photo" class="h-20 w-20 rounded-full object-cover ring-2 ring-[#e8f3ee]" />
                        }
                        else
                        {
                            <div class="flex h-20 w-20 items-center justify-center rounded-full bg-[#e8f3ee] font-serif text-2xl font-bold text-[#00754a]" aria-hidden="true">
                                @(string.IsNullOrWhiteSpace(Model.FullName) ? "B" : Model.FullName.Trim()[0].ToString().ToUpperInvariant())
                            </div>
                        }
                        <div class="flex-1">
                            <label asp-for="Avatar" class="@label"></label>
                            <input asp-for="Avatar" type="file" accept=".jpg,.png,.webp,image/jpeg,image/png,image/webp"
                                   class="block w-full text-sm text-gray-600 file:mr-4 file:rounded-full file:border-0 file:bg-[#e8f3ee] file:px-4 file:py-2 file:text-sm file:font-semibold file:text-[#1e3932] hover:file:bg-[#d4e9df]" />
                            <p class="mt-1 text-xs text-gray-400">JPG, PNG or WebP. Max 2 MB.</p>
                            <span asp-validation-for="Avatar" class="@err"></span>
                        </div>
                    <div>
                        <label asp-for="Profile.CampusId" class="@label"></label>
                        <input asp-for="Profile.CampusId" maxlength="30" autocomplete="off" class="@field" />
                        <span asp-validation-for="Profile.CampusId" class="@err"></span>
                    </div>

                    @if (string.IsNullOrEmpty(Model.CampusId))
                    {
                        <p class="rounded-xl border border-yellow-300 bg-yellow-50 px-4 py-3 text-sm text-yellow-800">
                            Add your Campus ID to complete your profile.
                        </p>
                    }

                <form asp-action="ChangePassword" method="post" class="mt-4 space-y-4">
                    @if (Model.HasPassword)
                    {
                    <div>
                        <label class="@label" for="profile-email">Email</label>
                        <input id="profile-email" value="@Model.Email" readonly disabled class="@field cursor-not-allowed text-gray-400" />
                    </div>
                    }
                    <div>
                        <label asp-for="FullName" class="@label"></label>
                        <input asp-for="FullName" maxlength="150" autocomplete="name" class="@field" />
                        <span asp-validation-for="FullName" class="@err"></span>
                    </div>
                    <div>
                        <label asp-for="CampusId" class="@label"></label>
                        <input asp-for="CampusId" maxlength="30" autocomplete="off" class="@field" />
                        <span asp-validation-for="CampusId" class="@err"></span>
                    </div>
                    <div>
                        <label asp-for="PhoneNumber" class="@label"></label>
                        <input asp-for="PhoneNumber" type="tel" maxlength="20" inputmode="tel" autocomplete="tel" placeholder="+63 9XX XXX XXXX" class="@field" />
                        <span asp-validation-for="PhoneNumber" class="@err"></span>
                    </div>

                    <button type="submit" class="@btn">Save changes</button>
                </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}