@* Views/Account/ResetPassword.cshtml *@
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}
<h1 class="text-xl font-semibold mb-2">Reset password</h1>
<p class="mb-4 text-sm text-stone-400">Enter the 6-digit code we sent to your email. It expires in 10 minutes.</p>
<form asp-action="ResetPassword" method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-400"></div>
    <div>
        <label asp-for="Email" class="block text-sm mb-1"></label>
        <input asp-for="Email" readonly class="@ViewData["Input"] opacity-70" />
        <span asp-validation-for="Email" class="text-xs text-red-400"></span>
    </div>
    <div>
        <label asp-for="Code" class="block text-sm mb-1"></label>
        <input asp-for="Code" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code"
               class="@ViewData["Input"] text-center text-lg tracking-[0.5em]" />
        <span asp-validation-for="Code" class="text-xs text-red-400"></span>
    </div>
    <div>
        <label asp-for="Password" class="block text-sm mb-1"></label>
        <input asp-for="Password" class="@ViewData["Input"]" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-xs text-red-400"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword" class="block text-sm mb-1"></label>
        <input asp-for="ConfirmPassword" class="@ViewData["Input"]" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-xs text-red-400"></span>
    </div>
    <button type="submit" class="@ViewData["Btn"]">Update password</button>
    <p class="text-sm text-stone-400 text-center">
        Didn't get a code? <a asp-action="ForgotPassword" class="hover:text-amber-400">Send a new one</a>
    </p>
</form>