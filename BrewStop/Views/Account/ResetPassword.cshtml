@* Views/Account/ResetPassword.cshtml *@
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}
<h1 class="text-xl font-semibold mb-4">Reset password</h1>
<form asp-action="ResetPassword" method="post" class="space-y-4">
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-400"></div>
    <div>
        <label asp-for="Password" class="block text-sm mb-1"></label>
        <input asp-for="Password" class="@ViewData["Input"]" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-xs text-red-400"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword" class="block text-sm mb-1"></label>
        <input asp-for="ConfirmPassword" class="@ViewData["Input"]" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-xs text-red-400"></span>
    </div>
    <button type="submit" class="@ViewData["Btn"]">Update password</button>
</form>