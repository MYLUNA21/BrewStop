@model AdminCustomersViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Customer Management";
}

<div class="tw">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <h1 class="font-serif text-2xl font-bold">Customer <span class="text-caramel">Management</span></h1>
        <form method="get" action="/Admin/Customers" class="flex gap-2">
            <input type="text" name="q" value="@Model.Query" placeholder="Name, email, campus ID, role"
                   class="w-64 rounded-lg border border-white/20 bg-black/30 px-3 py-2 text-sm text-cream placeholder-neutral-500" />
            <button type="submit" class="rounded-lg bg-caramel px-4 py-2 text-sm font-semibold text-espresso">Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.Query))
            {
                <a href="/Admin/Customers" class="rounded-lg border border-white/20 px-4 py-2 text-sm text-cream no-underline">Clear</a>
            }
        </form>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="mb-3 rounded-lg border border-green-500/30 bg-green-500/10 p-3 text-green-300">@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="mb-3 rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-red-300">@err</div>
    }

    <div class="overflow-x-auto rounded-xl border border-white/10 bg-card">
        <table class="min-w-full text-left text-sm">
            <thead class="bg-black/30 text-xs uppercase tracking-wider text-caramel">
                <tr>
                    <th class="px-4 py-3">Name</th>
                    <th class="px-4 py-3">Campus ID</th>
                    <th class="px-4 py-3">Email</th>
                    <th class="px-4 py-3">Role(s)</th>
                    <th class="px-4 py-3">Email Confirmed</th>
                    <th class="px-4 py-3">Account</th>
                    <th class="px-4 py-3">Orders</th>
                    <th class="px-4 py-3">Total Spent</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="px-4 py-3">
                            @r.FullName
                            @if (r.IsFrequent)
                            {
                                <span class="ml-1 rounded-full bg-caramel/15 px-2 py-0.5 text-xs font-semibold text-caramel">Frequent Customer</span>
                            }
                        </td>
                        <td class="px-4 py-3">@r.CampusId</td>
                        <td class="px-4 py-3">@r.Email</td>
                        <td class="px-4 py-3">@(r.Roles.Count == 0 ? "—" : string.Join(", ", r.Roles))</td>
                        <td class="px-4 py-3">
                            <span class="@(r.EmailConfirmed ? "text-green-300" : "text-amber-300")">@(r.EmailConfirmed ? "Yes" : "No")</span>
                        </td>
                        <td class="px-4 py-3">
                            <span class="rounded-full px-2.5 py-1 text-xs font-semibold @(r.IsLocked ? "bg-red-500/15 text-red-300" : "bg-green-500/15 text-green-300")">@(r.IsLocked ? "Locked" : "Active")</span>
                        </td>
                        <td class="px-4 py-3">@r.TotalOrders</td>
                        <td class="px-4 py-3">₱@r.TotalSpent.ToString("N2")</td>
                        <td class="px-4 py-3 text-right"><a href="/Admin/CustomerDetails/@r.Id" class="text-caramel no-underline hover:underline">View</a></td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="px-4 py-8 text-center text-neutral-400">No users found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>