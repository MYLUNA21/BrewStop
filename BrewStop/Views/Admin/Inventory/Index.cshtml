@inject BrewStop.Services.IImageResolver Images
@model List<BrewStop.Models.InventoryItem>
@{
    ViewData["Title"] = "Manage Inventory";
    var n = 0;
}

<div class="tw">
    <div class="mx-auto max-w-6xl p-6 pt-28 text-cream">
        <div class="mb-5 flex items-center justify-between">
            <h1 class="font-serif text-2xl font-bold">Inventory <span class="text-caramel">Management</span></h1>
            <a asp-controller="MenuItems" asp-action="Index"
               class="rounded-lg border border-white/20 px-4 py-2 text-sm text-cream hover:border-caramel hover:text-caramel">
                <i class="fa-solid fa-arrow-left mr-1"></i> Back to Menu
            </a>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="mb-3 rounded-lg border border-green-500/30 bg-green-500/10 p-3 text-green-300">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="mb-3 rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-red-300">@err</div>
        }

        <div class="overflow-x-auto rounded-xl border border-white/10 bg-card">
            <table class="min-w-full text-left text-sm">
                <thead class="bg-black/30 text-xs uppercase tracking-wider text-caramel">
                    <tr>
                        <th class="px-4 py-3">#</th>
                        <th class="px-4 py-3">Item</th>
                        <th class="px-4 py-3">Category</th>
                        <th class="px-4 py-3">Stock Status</th>
                        <th class="px-4 py-3 text-right">Set Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr class="border-t border-white/10 hover:bg-white/5">
                            <td class="px-4 py-3 text-neutral-400">@(++n)</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <img src="@Images.Resolve(i.MenuItem.ImageUrl, i.MenuItem.Name)" alt="" class="h-10 w-10 rounded-full object-cover ring-1 ring-white/10" />
                                    <span class="font-medium">@i.MenuItem.Name</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-neutral-300">@i.MenuItem.Category.Name</td>
                            <td class="px-4 py-3">
                                @if (i.Quantity == 0)
                                {
                                    <span class="inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-red-500"></span>Sold out</span>
                                }
                                else if (i.Quantity <= 5)
                                {
                                    <span class="inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-amber-400"></span>Low (@i.Quantity)</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-green-500"></span>Available (@i.Quantity)</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <form asp-action="Update" asp-route-id="@i.Id" method="post" class="flex items-center justify-end gap-2">
                                    <input type="number" name="quantity" min="0" value="@i.Quantity"
                                           class="w-20 rounded-lg border border-white/10 bg-black/30 px-3 py-1.5 text-center text-cream focus:border-caramel focus:outline-none" />
                                    <button class="rounded-lg bg-caramel px-4 py-1.5 text-xs font-semibold text-espresso hover:opacity-90">
                                        Save
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="border-t border-white/10 px-4 py-3 text-xs text-neutral-400">
                Showing <b class="text-cream">@Model.Count</b> entries
            </div>
        </div>
    </div>
</div>