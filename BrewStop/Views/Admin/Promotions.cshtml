@model AdminPromotionsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Discounts & Promotions";
    var now = DateTime.UtcNow;
    var inputCls = "w-full rounded-lg border border-white/20 bg-black/30 px-3 py-2 text-sm text-cream placeholder-neutral-500";
}

<div class="tw">
    <h1 class="mb-5 font-serif text-2xl font-bold">Discounts <span class="text-caramel">& Promotions</span></h1>

    @if (TempData["Success"] is string ok)
    {
        <div class="mb-3 rounded-lg border border-green-500/30 bg-green-500/10 p-3 text-green-300">@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="mb-3 rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-red-300">@err</div>
    }

    <form method="post" action="/Admin/CreatePromotion" class="mb-6 rounded-xl border border-white/10 bg-card p-5">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="mb-3 text-sm text-red-300"></div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
            <div>
                <label asp-for="Input.Code" class="mb-1 block text-xs uppercase text-neutral-400">Code</label>
                <input asp-for="Input.Code" maxlength="30" placeholder="MIDTERM10" class="@inputCls uppercase" />
            </div>
            <div>
                <label asp-for="Input.Title" class="mb-1 block text-xs uppercase text-neutral-400">Title</label>
                <input asp-for="Input.Title" maxlength="100" placeholder="Midterm Exam Week Promo" class="@inputCls" />
            </div>
            <div>
                <label asp-for="Input.DiscountType" class="mb-1 block text-xs uppercase text-neutral-400">Discount Type</label>
                <select asp-for="Input.DiscountType" class="@inputCls">
                    <option value="Percentage">Percentage (%)</option>
                    <option value="FixedAmount">Fixed Amount (₱)</option>
                </select>
            </div>
            <div>
                <label asp-for="Input.DiscountValue" class="mb-1 block text-xs uppercase text-neutral-400">Discount Value</label>
                <input asp-for="Input.DiscountValue" type="number" step="0.01" min="0.01" class="@inputCls" />
            </div>
            <div>
                <label asp-for="Input.ExpiryDate" class="mb-1 block text-xs uppercase text-neutral-400">Expiry Date</label>
                <input asp-for="Input.ExpiryDate" type="date" class="@inputCls" />
            </div>
            <div>
                <label asp-for="Input.MaxUses" class="mb-1 block text-xs uppercase text-neutral-400">Max Uses (optional)</label>
                <input asp-for="Input.MaxUses" type="number" min="1" placeholder="Unlimited" class="@inputCls" />
            </div>
        </div>
        <button type="submit" class="mt-4 rounded-lg bg-caramel px-5 py-2 text-sm font-semibold text-espresso">Create Promotion</button>
    </form>

    <div class="overflow-x-auto rounded-xl border border-white/10 bg-card">
        <table class="min-w-full text-left text-sm">
            <thead class="bg-black/30 text-xs uppercase tracking-wider text-caramel">
                <tr>
                    <th class="px-4 py-3">Code</th>
                    <th class="px-4 py-3">Title</th>
                    <th class="px-4 py-3">Discount</th>
                    <th class="px-4 py-3">Expiry</th>
                    <th class="px-4 py-3">Usage</th>
                    <th class="px-4 py-3">Active</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                @foreach (var p in Model.Promotions)
                {
                    var expired = p.ExpiryDate < now;
                    <tr>
                        <td class="px-4 py-3 font-mono font-semibold">@p.Code</td>
                        <td class="px-4 py-3">@p.Title</td>
                        <td class="px-4 py-3">@(p.DiscountType == DiscountType.Percentage ? $"{p.DiscountValue:0.##}%" : $"₱{p.DiscountValue:N2}")</td>
                        <td class="px-4 py-3">
                            @p.ExpiryDate.ToString("MMM d, yyyy")
                            @if (expired)
                            {
                                <span class="ml-1 rounded-full bg-red-500/15 px-2 py-0.5 text-xs font-semibold text-red-300">Expired</span>
                            }
                        </td>
                        <td class="px-4 py-3">@p.TimesUsed / @(p.MaxUses?.ToString() ?? "∞")</td>
                        <td class="px-4 py-3">
                            <form method="post" action="/Admin/TogglePromotion" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit"
                                        class="rounded-full px-3 py-1 text-xs font-semibold @(p.IsActive ? "bg-green-500/15 text-green-300 hover:bg-green-500/25" : "bg-neutral-500/20 text-neutral-300 hover:bg-neutral-500/30")">
                                    @(p.IsActive ? "Active" : "Inactive")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Promotions.Count == 0)
                {
                    <tr><td colspan="6" class="px-4 py-8 text-center text-neutral-400">No promotions yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>