@model AdminReportsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reports & Records";
    var s = Model.StartDate.ToString("yyyy-MM-dd");
    var e = Model.EndDate.ToString("yyyy-MM-dd");
}

<style>
    /* ============ BrewStop Reports — dark coffee + caramel/amber ============ */
    .rp-root {
        --rp-card: #241411;
        --rp-card-hi: #2f1b16;
        --rp-caramel: #d4a373;
        --rp-amber: #f0a93b;
        --rp-cream: #fefae0;
        --rp-muted: #a8998f;
        --rp-line: rgba(255, 255, 255, .08);
        --rp-glow: 0 10px 26px -8px rgba(240, 169, 59, .55);
    }

    /* ---------- Buttons & filter bar ---------- */
    .rp-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        border-radius: 10px;
        padding: .55rem 1rem;
        font-size: .875rem;
        line-height: 1.25rem;
        text-decoration: none;
        cursor: pointer;
        transition: transform .18s ease, box-shadow .18s ease, background-color .18s ease, border-color .18s ease, color .18s ease;
    }

        .rp-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--rp-glow);
        }

        .rp-btn:active {
            transform: translateY(0);
            box-shadow: none;
        }

        .rp-btn:focus-visible {
            outline: 2px solid var(--rp-amber);
            outline-offset: 2px;
        }

    .rp-btn-primary {
        background: linear-gradient(135deg, #e0b283, #d4a373 55%, #c68f5a);
        color: #1a0f0d;
        font-weight: 700;
        border: 1px solid transparent;
    }

        .rp-btn-primary:hover {
            background: linear-gradient(135deg, #ecc196, #dcab7b 55%, #d19862);
            color: #1a0f0d;
        }

    .rp-btn-ghost {
        background: rgba(255, 255, 255, .02);
        border: 1px solid rgba(255, 255, 255, .2);
        color: var(--rp-cream);
    }

        .rp-btn-ghost:hover {
            border-color: var(--rp-caramel);
            color: var(--rp-caramel);
            background: rgba(212, 163, 115, .08);
        }

    .rp-btn.is-loading {
        pointer-events: none;
        opacity: .75;
    }

        .rp-btn.is-loading::after {
            content: "";
            width: .8rem;
            height: .8rem;
            border-radius: 50%;
            border: 2px solid currentColor;
            border-right-color: transparent;
            animation: rp-spin .7s linear infinite;
        }

    .rp-filter {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: .85rem;
        padding: .9rem 1rem;
        border-radius: 14px;
        background: linear-gradient(180deg, var(--rp-card-hi), var(--rp-card));
        border: 1px solid var(--rp-line);
        transition: box-shadow .2s ease, border-color .2s ease, transform .2s ease;
    }

        .rp-filter:hover, .rp-filter:focus-within {
            transform: translateY(-2px);
            border-color: rgba(240, 169, 59, .35);
            box-shadow: 0 12px 30px -12px rgba(240, 169, 59, .4);
        }

    .rp-label {
        display: block;
        margin-bottom: .25rem;
        font-size: .7rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--rp-muted);
    }

    .rp-input {
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, .18);
        background: rgba(0, 0, 0, .35);
        padding: .5rem .75rem;
        font-size: .875rem;
        color: var(--rp-cream);
        color-scheme: dark;
        transition: border-color .18s ease, box-shadow .18s ease;
    }

        .rp-input:hover {
            border-color: rgba(212, 163, 115, .6);
        }

        .rp-input:focus {
            outline: none;
            border-color: var(--rp-amber);
            box-shadow: 0 0 0 3px rgba(240, 169, 59, .22);
        }

    /* ---------- Section headings ---------- */
    .rp-h2 {
        margin: 2rem 0 .6rem;
        display: flex;
        align-items: center;
        gap: .6rem;
        font-family: Georgia, serif;
        font-size: 1.125rem;
        font-weight: 700;
    }

        .rp-h2::before {
            content: "";
            width: 4px;
            height: 1.1rem;
            border-radius: 4px;
            background: linear-gradient(var(--rp-amber), var(--rp-caramel));
        }

    .rp-h3 {
        margin: 0 0 .5rem;
        font-family: Georgia, serif;
        font-size: 1rem;
        font-weight: 700;
    }

    /* ---------- Floating row-card tables ---------- */
    .rp-scroll {
        overflow-x: auto;
        padding: 2px 6px 8px 2px;
        margin: 0 -6px 0 -2px;
    }

    .rp-table {
        min-width: 560px;
    }

        .rp-table.rp-wide {
            min-width: 900px;
        }

        .rp-table.rp-narrow {
            min-width: 340px;
        }

    .rp-cols-sales {
        grid-template-columns: minmax(130px, 1.2fr) repeat(4, minmax(96px, 1fr));
    }

    .rp-cols-product {
        grid-template-columns: 44px minmax(120px, 2fr) 70px minmax(100px, 1fr);
    }

    .rp-cols-tx {
        grid-template-columns: 70px 140px minmax(110px, 1.1fr) minmax(180px, 2fr) 84px 104px 112px;
    }

    .rp-head, .rp-row {
        display: grid;
        align-items: center;
        column-gap: .75rem;
        padding: 0 1rem;
    }

    .rp-head {
        padding-top: .35rem;
        padding-bottom: .35rem;
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .09em;
        text-transform: uppercase;
        color: var(--rp-caramel);
    }

    .rp-row {
        position: relative;
        margin-top: 8px;
        padding-top: .7rem;
        padding-bottom: .7rem;
        border-radius: 10px;
        border-left: 4px solid var(--rp-caramel);
        background: var(--rp-card);
        box-shadow: 0 1px 0 rgba(255, 255, 255, .03) inset, 0 2px 8px -2px rgba(0, 0, 0, .45);
        font-size: .875rem;
        color: var(--rp-cream);
        transition: transform .18s ease, background-color .18s ease, box-shadow .18s ease, border-color .18s ease;
        animation: rp-in .38s ease both;
        animation-delay: calc(min(var(--i, 0), 14) * 35ms);
    }

        .rp-row:nth-child(even) {
            border-left-color: var(--rp-amber);
        }

        .rp-row:hover {
            transform: translateX(4px);
            background: var(--rp-card-hi);
            box-shadow: 0 10px 24px -10px rgba(0, 0, 0, .7), 0 0 0 1px rgba(240, 169, 59, .2);
        }

    .rp-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum";
        white-space: nowrap;
    }

    .rp-muted {
        color: var(--rp-muted);
    }

    .rp-disc {
        color: var(--rp-amber);
    }

    .rp-wrap {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .rp-sub {
        color: #cfc3ba;
        font-size: .8rem;
    }

    .rp-badge {
        justify-self: start;
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .8rem;
        letter-spacing: .02em;
        padding: .2rem .55rem;
        border-radius: 7px;
        color: var(--rp-caramel);
        background: rgba(212, 163, 115, .12);
        border: 1px solid rgba(212, 163, 115, .28);
    }

    .rp-net {
        justify-self: end;
        font-weight: 700;
        color: #1a0f0d;
        font-variant-numeric: tabular-nums;
        padding: .2rem .6rem;
        border-radius: 8px;
        background: linear-gradient(135deg, #e6b98a, var(--rp-caramel));
        box-shadow: 0 4px 14px -6px rgba(240, 169, 59, .7);
        white-space: nowrap;
    }

    .rp-rank {
        display: inline-flex;
        width: 1.7rem;
        height: 1.7rem;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: .75rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--rp-caramel);
        background: rgba(212, 163, 115, .12);
        border: 1px solid rgba(212, 163, 115, .28);
    }

    .rp-pill {
        justify-self: start;
        display: inline-block;
        padding: .15rem .55rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 600;
        background: rgba(240, 169, 59, .14);
        color: var(--rp-amber);
        border: 1px solid rgba(240, 169, 59, .3);
    }

        .rp-pill[data-status="Claimed"] {
            background: rgba(74, 222, 128, .12);
            color: #86efac;
            border-color: rgba(74, 222, 128, .3);
        }

        .rp-pill[data-status="Cancelled"] {
            background: rgba(248, 113, 113, .12);
            color: #fca5a5;
            border-color: rgba(248, 113, 113, .3);
        }

    .rp-empty {
        margin-top: 8px;
        padding: 1.4rem 1rem;
        text-align: center;
        border-radius: 10px;
        border: 1px dashed rgba(255, 255, 255, .15);
        color: var(--rp-muted);
        font-size: .875rem;
    }

    @@keyframes rp-in {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@keyframes rp-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .rp-row, .rp-btn, .rp-filter {
            animation: none !important;
            transition: none !important;
        }

            .rp-row:hover, .rp-btn:hover, .rp-filter:hover {
                transform: none !important;
            }
    }

    /* ---------- Print ---------- */
    @@media print {
        html body aside, html body .no-print {
            display: none !important;
        }

        html body main {
            padding: 0 !important;
        }

        html body .tw .print-area, html body .tw .print-area * {
            background: #fff !important;
            color: #000 !important;
            border-color: #999 !important;
            box-shadow: none !important;
            text-shadow: none !important;
        }

            html body .tw .print-area .rp-row {
                transform: none !important;
                animation: none !important;
                opacity: 1 !important;
                margin-top: 0;
                border-radius: 0;
                border-left: 3px solid #666 !important;
                border-bottom: 1px solid #ccc !important;
                padding-top: .3rem;
                padding-bottom: .3rem;
                break-inside: avoid;
                page-break-inside: avoid;
                font-size: 11px;
            }

            html body .tw .print-area .rp-head {
                font-size: 10px;
                border-bottom: 2px solid #000 !important;
            }

            html body .tw .print-area .rp-badge,
            html body .tw .print-area .rp-pill,
            html body .tw .print-area .rp-rank {
                border: 0 !important;
                padding: 0;
                font-weight: 600;
            }

            html body .tw .print-area .rp-net {
                padding: 0;
                font-weight: 800;
            }

            html body .tw .print-area .rp-scroll {
                overflow: visible;
                margin: 0;
                padding: 0;
            }

            html body .tw .print-area .rp-table {
                min-width: 0 !important;
            }

            html body .tw .print-area .rp-h2 {
                break-after: avoid;
            }

                html body .tw .print-area .rp-h2::before {
                    display: none;
                }
    }
</style>

<div class="tw">
    <div class="print-area rp-root">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <h1 class="font-serif text-2xl font-bold">
                Reports <span class="text-caramel">& Records</span>
                <span class="block text-sm font-normal text-neutral-400">@s to @e (UTC)</span>
            </h1>
            <div class="no-print flex flex-wrap gap-2">
                <a href="/Admin/ExportReportsCsv?startDate=@s&endDate=@e"
                   class="rp-btn rp-btn-primary">
                    <i class="fa-solid fa-file-csv mr-1"></i> Export to Excel (.csv)
                </a>
                <button type="button" onclick="window.print()"
                        class="rp-btn rp-btn-ghost">
                    <i class="fa-solid fa-print mr-1"></i> Print / Save as PDF
                </button>
            </div>
        </div>

        <form method="get" action="/Admin/Reports" class="no-print rp-filter mb-6" id="rp-filter-form">
            <div>
                <label class="rp-label">Start Date</label>
                <input type="date" name="startDate" value="@s" class="rp-input" />
            </div>
            <div>
                <label class="rp-label">End Date</label>
                <input type="date" name="endDate" value="@e" class="rp-input" />
            </div>
            <button type="submit" class="rp-btn rp-btn-primary" id="rp-apply">Apply</button>
            <a href="/Admin/Reports" class="rp-btn rp-btn-ghost">Reset</a>
        </form>

        @{
            void SalesTable(string title, string col, List<AdminSalesRow> rows)
            {
                <h2 class="rp-h2">@title</h2>
                <div class="rp-scroll">
                    <div class="rp-table" role="table" aria-label="@title">
                        <div class="rp-head rp-cols-sales" role="row">
                            <div role="columnheader">@col</div>
                            <div role="columnheader" class="rp-num">Orders</div>
                            <div role="columnheader" class="rp-num">Gross Sales</div>
                            <div role="columnheader" class="rp-num">Discounts</div>
                            <div role="columnheader" class="rp-num">Net Revenue</div>
                        </div>
                        @for (var i = 0; i < rows.Count; i++)
                        {
                            var r = rows[i];
                            <div class="rp-row rp-cols-sales" role="row" style="--i:@i">
                                <div role="cell"><span class="rp-badge">@r.Label</span></div>
                                <div role="cell" class="rp-num">@r.Orders</div>
                                <div role="cell" class="rp-num">₱@r.Gross.ToString("N2")</div>
                                <div role="cell" class="rp-num @(r.Discounts > 0 ? "rp-disc" : "rp-muted")">₱@r.Discounts.ToString("N2")</div>
                                <div role="cell" class="rp-num"><span class="rp-net">₱@r.Net.ToString("N2")</span></div>
                            </div>
                        }
                        @if (rows.Count == 0)
                        {
                            <div class="rp-empty">No sales in this range.</div>
                        }
                    </div>
                </div>
            }

            void ProductTable(string title, List<AdminProductRow> rows)
            {
                <div>
                    <h3 class="rp-h3">@title</h3>
                    <div class="rp-scroll">
                        <div class="rp-table rp-narrow" role="table" aria-label="@title">
                            <div class="rp-head rp-cols-product" role="row">
                                <div role="columnheader">#</div>
                                <div role="columnheader">Product</div>
                                <div role="columnheader" class="rp-num">Units</div>
                                <div role="columnheader" class="rp-num">Revenue</div>
                            </div>
                            @for (var i = 0; i < rows.Count; i++)
                            {
                                <div class="rp-row rp-cols-product" role="row" style="--i:@i">
                                    <div role="cell"><span class="rp-rank">@(i + 1)</span></div>
                                    <div role="cell" class="rp-wrap">@rows[i].Name</div>
                                    <div role="cell" class="rp-num">@rows[i].Units</div>
                                    <div role="cell" class="rp-num"><span class="rp-net">₱@rows[i].Revenue.ToString("N2")</span></div>
                                </div>
                            }
                            @if (rows.Count == 0)
                            {
                                <div class="rp-empty">No products in this range.</div>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        @{
            SalesTable("Daily Sales Summary", "Date", Model.Daily);
        }
        @{
            SalesTable("Monthly Revenue Summary", "Month", Model.Monthly);
        }

        <h2 class="rp-h2">Product Performance</h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            @{
                ProductTable("Most Popular", Model.MostPopular);
            }
            @{
                ProductTable("Least Popular", Model.LeastPopular);
            }
        </div>

        <h2 class="rp-h2">Transaction Records</h2>
        <div class="rp-scroll">
            <div class="rp-table rp-wide" role="table" aria-label="Transaction Records">
                <div class="rp-head rp-cols-tx" role="row">
                    <div role="columnheader">Order</div>
                    <div role="columnheader">Date/Time (UTC)</div>
                    <div role="columnheader">Customer</div>
                    <div role="columnheader">Items</div>
                    <div role="columnheader">Payment</div>
                    <div role="columnheader">Status</div>
                    <div role="columnheader" class="rp-num">Total</div>
                </div>
                @{
                    var ti = 0;
                }
                @foreach (var o in Model.Transactions)
                {
                    <div class="rp-row rp-cols-tx" role="row" style="--i:@(ti++)">
                        <div role="cell" class="rp-num" style="text-align:left"><span class="rp-badge">#@o.Id</span></div>
                        <div role="cell" class="rp-sub" style="font-family:ui-monospace,Menlo,Consolas,monospace;font-variant-numeric:tabular-nums">@o.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
                        <div role="cell" class="rp-wrap">@o.User.FullName</div>
                        <div role="cell" class="rp-wrap rp-sub">@AdminReportsViewModel.ItemsSummary(o)</div>
                        <div role="cell" class="rp-sub">@o.PaymentMethod</div>
                        <div role="cell"><span class="rp-pill" data-status="@o.Status">@o.Status</span></div>
                        <div role="cell" class="rp-num"><span class="rp-net">₱@o.Total.ToString("N2")</span></div>
                    </div>
                }
                @if (Model.Transactions.Count == 0)
                {
                    <div class="rp-empty">No transactions in this range.</div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        var form = document.getElementById('rp-filter-form');
        var apply = document.getElementById('rp-apply');
        if (form && apply) {
            form.addEventListener('submit', function() { apply.classList.add('is-loading'); });
        }
        // Keep End Date >= Start Date in the picker (UI hint only; server logic untouched)
        var start = form && form.querySelector('input[name="startDate"]');
        var end = form && form.querySelector('input[name="endDate"]');
        if (start && end) {
            var sync = function() { if (start.value) end.min = start.value; };
            start.addEventListener('change', sync); sync();
        }
        // Reset entrance animation if user returns via back/forward cache
        window.addEventListener('pageshow', function(ev) {
            if (!ev.persisted) return;
            document.querySelectorAll('.rp-row').forEach(function(r) {
                r.style.animation = 'none'; void r.offsetWidth; r.style.animation = '';
            });
            if (apply) apply.classList.remove('is-loading');
        });
    })();
</script>