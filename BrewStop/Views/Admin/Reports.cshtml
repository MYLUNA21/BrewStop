@model AdminReportsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reports & Records";
    var s = Model.StartDate.ToString("yyyy-MM-dd");
    var e = Model.EndDate.ToString("yyyy-MM-dd");
}

<style>
    @@media print {
        html body aside, html body .no-print { display: none !important; }
        html body main { padding: 0 !important; }
        html body .tw .print-area, html body .tw .print-area * {
            background: #fff !important;
            color: #000 !important;
            border-color: #999 !important;
        }
        html body .tw .print-area table { font-size: 11px; }
    }
</style>

<div class="tw">
    <div class="print-area">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <h1 class="font-serif text-2xl font-bold">
                Reports <span class="text-caramel">& Records</span>
                <span class="block text-sm font-normal text-neutral-400">@s to @e (UTC)</span>
            </h1>
            <div class="no-print flex gap-2">
                <a href="/Admin/ExportReportsCsv?startDate=@s&endDate=@e"
                   class="rounded-lg bg-caramel px-4 py-2 text-sm font-semibold text-espresso no-underline">
                    <i class="fa-solid fa-file-csv mr-1"></i> Export to Excel (.csv)
                </a>
                <button type="button" onclick="window.print()"
                        class="rounded-lg border border-white/20 px-4 py-2 text-sm text-cream hover:border-caramel hover:text-caramel">
                    <i class="fa-solid fa-print mr-1"></i> Print / Save as PDF
                </button>
            </div>
        </div>

        <form method="get" action="/Admin/Reports" class="no-print mb-6 flex flex-wrap items-end gap-3">
            <div>
                <label class="mb-1 block text-xs uppercase text-neutral-400">Start Date</label>
                <input type="date" name="startDate" value="@s" class="rounded-lg border border-white/20 bg-black/30 px-3 py-2 text-sm text-cream" />
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase text-neutral-400">End Date</label>
                <input type="date" name="endDate" value="@e" class="rounded-lg border border-white/20 bg-black/30 px-3 py-2 text-sm text-cream" />
            </div>
            <button type="submit" class="rounded-lg bg-caramel px-4 py-2 text-sm font-semibold text-espresso">Apply</button>
            <a href="/Admin/Reports" class="rounded-lg border border-white/20 px-4 py-2 text-sm text-cream no-underline">Reset</a>
        </form>

        @{
            void SalesTable(string title, string col, List<AdminSalesRow> rows)
            {
                <h2 class="mb-2 mt-6 font-serif text-lg font-bold">@title</h2>
                <div class="overflow-x-auto rounded-xl border border-white/10 bg-card">
                    <table class="min-w-full text-left text-sm">
                        <thead class="bg-black/30 text-xs uppercase tracking-wider text-caramel">
                            <tr>
                                <th class="px-4 py-3">@col</th>
                                <th class="px-4 py-3">Orders</th>
                                <th class="px-4 py-3">Gross Sales</th>
                                <th class="px-4 py-3">Discounts</th>
                                <th class="px-4 py-3">Net Revenue</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            @foreach (var r in rows)
                            {
                                <tr>
                                    <td class="px-4 py-2">@r.Label</td>
                                    <td class="px-4 py-2">@r.Orders</td>
                                    <td class="px-4 py-2">₱@r.Gross.ToString("N2")</td>
                                    <td class="px-4 py-2">₱@r.Discounts.ToString("N2")</td>
                                    <td class="px-4 py-2 font-semibold">₱@r.Net.ToString("N2")</td>
                                </tr>
                            }
                            @if (rows.Count == 0)
                            {
                                <tr><td colspan="5" class="px-4 py-6 text-center text-neutral-400">No sales in this range.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            void ProductTable(string title, List<AdminProductRow> rows)
            {
                <div>
                    <h3 class="mb-2 font-serif text-base font-bold">@title</h3>
                    <div class="overflow-x-auto rounded-xl border border-white/10 bg-card">
                        <table class="min-w-full text-left text-sm">
                            <thead class="bg-black/30 text-xs uppercase tracking-wider text-caramel">
                                <tr>
                                    <th class="px-4 py-3">#</th>
                                    <th class="px-4 py-3">Product</th>
                                    <th class="px-4 py-3">Units</th>
                                    <th class="px-4 py-3">Revenue</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                @for (var i = 0; i < rows.Count; i++)
                                {
                                    <tr>
                                        <td class="px-4 py-2">@(i + 1)</td>
                                        <td class="px-4 py-2">@rows[i].Name</td>
                                        <td class="px-4 py-2">@rows[i].Units</td>
                                        <td class="px-4 py-2">₱@rows[i].Revenue.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @{
            SalesTable("Daily Sales Summary", "Date", Model.Daily);
        }
        @{
            SalesTable("Monthly Revenue Summary", "Month", Model.Monthly);
        }

        <h2 class="mb-2 mt-6 font-serif text-lg font-bold">Product Performance</h2>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            @{
                ProductTable("Most Popular", Model.MostPopular);
            }
            @{
                ProductTable("Least Popular", Model.LeastPopular);
            }
        </div>

        <h2 class="mb-2 mt-6 font-serif text-lg font-bold">Transaction Records</h2>
        <div class="overflow-x-auto rounded-xl border border-white/10 bg-card">
            <table class="min-w-full text-left text-sm">
                <thead class="bg-black/30 text-xs uppercase tracking-wider text-caramel">
                    <tr>
                        <th class="px-4 py-3">Order</th>
                        <th class="px-4 py-3">Date/Time (UTC)</th>
                        <th class="px-4 py-3">Customer</th>
                        <th class="px-4 py-3">Items</th>
                        <th class="px-4 py-3">Payment</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3">Total</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    @foreach (var o in Model.Transactions)
                    {
                        <tr>
                            <td class="px-4 py-2">#@o.Id</td>
                            <td class="px-4 py-2">@o.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="px-4 py-2">@o.User.FullName</td>
                            <td class="px-4 py-2">@AdminReportsViewModel.ItemsSummary(o)</td>
                            <td class="px-4 py-2">@o.PaymentMethod</td>
                            <td class="px-4 py-2">@o.Status</td>
                            <td class="px-4 py-2">₱@o.Total.ToString("N2")</td>
                        </tr>
                    }
                    @if (Model.Transactions.Count == 0)
                    {
                        <tr><td colspan="7" class="px-4 py-6 text-center text-neutral-400">No transactions in this range.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>