@model BrewStop.Models.BaristaDashboardViewModel
@inject BrewStop.Services.IPickupSlotService Slots
@{
    ViewData["Title"] = "Barista Dashboard";
    var nowUtc = DateTime.UtcNow;
    string Ago(DateTime utc)
    {
        var m = (int)Math.Max(0, (nowUtc - DateTime.SpecifyKind(utc, DateTimeKind.Utc)).TotalMinutes);
        return m < 1 ? "just now" : m < 60 ? $"{m} min ago" : m < 1440 ? $"{m / 60} h ago" : $"{m / 1440} d ago";
    }
    var tiles = new (string Label, int Value, string Icon, string Href, string Tone)[]
    {
        ("Waiting in queue", Model.Placed, "fa-list-ol", "/Barista/Queue", "text-caramel"),
        ("Preparing", Model.Preparing, "fa-mug-hot", "/Barista/Preparation", "text-emerald-300"),
        ("Ready for pickup", Model.Ready, "fa-bag-shopping", "/Barista/Status", "text-cream"),
        ("Orders today", Model.OrdersToday, "fa-receipt", "/Barista/Status", "text-cream"),
        ("Picked up today", Model.ClaimedToday, "fa-circle-check", "/Barista/Status", "text-emerald-300"),
        ("Cancelled today", Model.CancelledToday, "fa-ban", "/Barista/Notifications", "text-red-300"),
    };
}

<div class="tw">
    <div class="mx-auto max-w-6xl px-4 pt-6 pb-8">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
                <h1 class="font-serif text-3xl font-bold text-cream">Dashboard</h1>
                <p class="mt-1 text-sm text-neutral-400">@Model.LocalNow.ToString("dddd, MMMM d, yyyy") · daily order statistics</p>
            </div>
            @if (Model.OpenShift is not null)
            {
                <a href="/Barista/Shifts" class="rounded-full border border-solid border-emerald-400/40 bg-emerald-400/10 px-4 py-2 text-sm font-semibold text-emerald-200 no-underline">
                    <i class="fa-solid fa-clock mr-1.5"></i>Clocked in since @Slots.ToLocal(Model.OpenShift.ClockInAt!.Value).ToString("h:mm tt")
                </a>
            }
            else
            {
                <a href="/Barista/Shifts" class="rounded-full border border-solid border-white/15 px-4 py-2 text-sm font-semibold text-neutral-300 no-underline hover:border-caramel hover:text-caramel">
                    <i class="fa-regular fa-clock mr-1.5"></i>Not clocked in
                </a>
            }
        </div>

        @if (Model.LowStockCount > 0)
        {
            <a href="/Barista/Notifications" class="mt-4 flex items-center gap-3 rounded-xl border border-solid border-yellow-500/40 bg-yellow-500/10 px-4 py-3 text-sm text-yellow-200 no-underline">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>@Model.LowStockCount item(s) are low or out of stock. Tell the shop admin to restock.</span>
            </a>
        }

        <div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-3">
            @foreach (var t in tiles)
            {
                <a href="@t.Href" class="rounded-2xl border border-solid border-white/10 bg-card p-4 no-underline transition hover:border-caramel/60">
                    <div class="flex items-center justify-between">
                        <p class="text-xs font-bold uppercase tracking-wider text-neutral-400">@t.Label</p>
                        <i class="fa-solid @t.Icon @t.Tone"></i>
                    </div>
                    <p class="mt-2 font-serif text-4xl font-extrabold text-cream">@t.Value</p>
                </a>
            }
        </div>

        <div class="mt-6 grid gap-5 lg:grid-cols-3">
            <section class="rounded-2xl border border-solid border-white/10 bg-card p-5 lg:col-span-1">
                <h2 class="font-serif text-lg font-bold text-cream">Most ordered today</h2>
                @if (Model.TopItems.Count == 0)
                {
                    <p class="mt-3 text-sm text-neutral-500">No orders yet today.</p>
                }
                else
                {
                    var max = Model.TopItems.Max(i => i.Quantity);
                    <ul class="mt-4 space-y-3">
                        @foreach (var i in Model.TopItems)
                        {
                            var pct = (int)Math.Round(100.0 * i.Quantity / max);
                            <li>
                                <div class="flex items-center justify-between gap-3 text-sm">
                                    <span class="truncate text-cream">@i.Name</span>
                                    <span class="shrink-0 font-bold text-caramel">@(i.Quantity)x</span>
                                </div>
                                <div class="mt-1 h-2 overflow-hidden rounded-full bg-white/10">
                                    <div class="h-full rounded-full bg-[#00754a]" style="width:@(pct)%"></div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="rounded-2xl border border-solid border-white/10 bg-card p-5 lg:col-span-2">
                <h2 class="font-serif text-lg font-bold text-cream">Recent activity</h2>
                @if (Model.Recent.Count == 0)
                {
                    <p class="mt-3 text-sm text-neutral-500">No recent order activity.</p>
                }
                else
                {
                    <ul class="mt-3 max-h-[420px] overflow-y-auto pr-1 [scrollbar-width:thin]">
                        @foreach (var a in Model.Recent)
                        {
                            <li class="flex items-start gap-3 border-t border-solid border-white/10 py-3 first:border-t-0">
                                <span class="mt-0.5 grid size-9 shrink-0 place-items-center rounded-full bg-[#1e3932] text-emerald-200"><i class="fa-solid @a.Icon text-sm"></i></span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-semibold text-cream">@a.Title</p>
                                    <p class="text-xs text-neutral-400">@a.Text</p>
                                </div>
                                <time datetime="@DateTime.SpecifyKind(a.AtUtc, DateTimeKind.Utc).ToString("o")" class="shrink-0 text-xs text-neutral-500">@Ago(a.AtUtc)</time>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
</div>