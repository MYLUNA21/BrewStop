@model List<BrewStop.Models.Order>
@inject BrewStop.Services.IPickupSlotService Slots
@{
    ViewData["Title"] = "Barista queue";
}

<div class="tw">
    <div class="mx-auto max-w-5xl px-4 pt-24 pb-12">
        <h1 class="font-serif text-3xl font-bold text-cream">Barista queue</h1>

        @if (TempData["Success"] is string ok)
        {
            <p class="mt-4 rounded-xl bg-green-500/10 p-3 text-sm text-green-300">@ok</p>
        }
        @if (TempData["Error"] is string err)
        {
            <p class="mt-4 rounded-xl bg-red-500/10 p-3 text-sm text-red-300">@err</p>
        }

        <form asp-action="Scan" method="post" class="mt-6 flex flex-col gap-3 rounded-2xl border border-white/10 bg-card p-4 sm:flex-row">
            <input name="token" autocomplete="off" autofocus maxlength="512"
                   placeholder="Scan or paste pickup QR token"
                   class="flex-1 rounded-xl border border-white/10 bg-espresso px-4 py-2 text-sm text-cream" />
            <button class="rounded-full bg-caramel px-5 py-2 text-sm font-semibold text-black">Verify pickup</button>
        </form>

        @if (Model.Count == 0)
        {
            <p class="mt-6 text-neutral-400">No active orders.</p>
        }
        else
        {
            <div class="mt-6 space-y-3">
                @foreach (var o in Model)
                {
                    <div class="rounded-2xl border border-white/10 bg-card p-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="font-semibold text-cream">Order #@o.Id &middot; @o.User.FullName</p>
                                <p class="text-xs text-neutral-400">Pickup @Slots.ToLocal(o.PickupAtUtc).ToString("ddd h:mm tt")</p>
                            </div>
                            <span class="rounded-full border border-caramel/40 px-3 py-1 text-xs text-caramel">@o.Status</span>
                        </div>

                        <ul class="mt-3 text-sm text-cream">
                            @foreach (var i in o.Items)
                            {
                                <li>
                                    @i.Quantity &times; @i.ItemName @(i.SizeName is null ? "" : $"({i.SizeName})")
                                    @if (i.AddOns.Count > 0)
                                    {
                                        <span class="text-xs text-neutral-400">+ @string.Join(", ", i.AddOns.Select(a => a.Name))</span>
                                    }
                                </li>
                            }
                        </ul>

                        @if (!string.IsNullOrWhiteSpace(o.Note))
                        {
                            <p class="mt-2 text-xs text-neutral-400">Note: @o.Note</p>
                        }

                        @if (o.Status != BrewStop.Models.OrderStatus.Ready)
                        {
                            <form asp-action="Advance" asp-route-id="@o.Id" method="post" class="mt-3">
                                <button class="rounded-full border border-white/20 px-4 py-1.5 text-sm text-cream hover:border-caramel">
                                    @(o.Status == BrewStop.Models.OrderStatus.Placed ? "Start preparing" : "Mark ready")
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="mt-3 text-sm text-neutral-400">Waiting for customer pickup (scan QR above).</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>