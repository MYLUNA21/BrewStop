@model BrewStop.Models.CartViewModel
@{
    ViewData["Title"] = "Your cart";
}

<div class="tw">
    <div class="mx-auto max-w-6xl px-4 pt-24 pb-16">

        <a asp-controller="Menu" asp-action="Index"
           class="inline-flex items-center gap-2 text-sm font-semibold text-caramel hover:text-cream">
            <i class="fa-solid fa-arrow-left text-xs"></i> Back to menu
        </a>

        <div class="mt-3 flex items-end justify-between border-b border-white/10 pb-4">
            <h1 class="font-serif text-3xl font-bold text-cream">Your cart</h1>
            @if (Model.Lines.Count > 0)
            {
                <span class="text-sm text-neutral-400">@Model.ItemCount item@(Model.ItemCount == 1 ? "" : "s")</span>
            }
        </div>

        @if (TempData["CartError"] is string cartErr)
        {
            <div class="mt-4 flex items-start gap-3 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200">
                <i class="fa-solid fa-circle-exclamation mt-0.5"></i><span>@cartErr</span>
            </div>
        }

        @if (Model.Lines.Count == 0)
        {
            <div class="mt-8 rounded-3xl border border-white/10 bg-card px-6 py-16 text-center">
                <div class="mx-auto grid size-20 place-items-center rounded-full bg-caramel/10 text-3xl text-caramel">
                    <i class="fa-solid fa-mug-hot"></i>
                </div>
                <h2 class="mt-5 font-serif text-xl font-semibold text-cream">Your cart is empty</h2>
                <p class="mt-1 text-sm text-neutral-400">Pick a drink or a pastry and skip the queue.</p>
                <a asp-controller="Menu" asp-action="Index"
                   class="mt-6 inline-block rounded-full bg-caramel px-8 py-3 text-sm font-semibold text-black transition hover:bg-cream">
                    Browse the menu
                </a>
            </div>
        }
        else
        {
            <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_360px]">

                <!-- Line items -->
                <ul class="space-y-4">
                    @foreach (var l in Model.Lines)
                    {
                        <li class="rounded-3xl border @(l.ExceedsStock ? "border-red-500/40" : "border-white/10") bg-card p-4 sm:p-5">
                            <div class="flex gap-4">
                                <div class="size-24 shrink-0 overflow-hidden rounded-2xl bg-espresso ring-2 ring-caramel/30 sm:size-28">
                                    <img src="@l.ImageUrl" alt="@l.Name" class="size-full object-cover" />
                                </div>

                                <div class="flex min-w-0 flex-1 flex-col">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0">
                                            <h3 class="truncate font-serif text-lg font-semibold text-cream">@l.Name</h3>
                                            <div class="mt-1.5 flex flex-wrap gap-1.5">
                                                @if (l.SizeName is not null)
                                                {
                                                    <span class="rounded-full bg-white/5 px-2.5 py-0.5 text-xs text-neutral-300">@l.SizeName</span>
                                                }
                                                @foreach (var a in l.AddOns)
                                                {
                                                    <span class="rounded-full bg-caramel/10 px-2.5 py-0.5 text-xs text-caramel">+ @a.Name</span>
                                                }
                                            </div>
                                        </div>
                                        <p class="shrink-0 text-lg font-bold text-cream">&#8369;@l.LineTotal.ToString("N2")</p>
                                    </div>

                                    @if (l.ExceedsStock)
                                    {
                                        <p class="mt-2 flex items-center gap-1.5 text-xs text-red-300">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            Only @l.StockLeft left in stock. Lower the quantity to continue.
                                        </p>
                                    }

                                    <div class="mt-auto flex items-center justify-between pt-4">
                                        <!-- Quantity stepper -->
                                        <div class="inline-flex items-center overflow-hidden rounded-full border border-white/15">
                                            <form asp-controller="Cart" asp-action="Update" method="post">
                                                <input type="hidden" name="key" value="@l.Key" />
                                                <input type="hidden" name="quantity" value="@(l.Quantity - 1)" />
                                                <button type="submit" @(l.Quantity <= 1 ? "disabled" : "")
                                                        aria-label="Decrease quantity of @l.Name"
                                                        class="grid size-9 place-items-center bg-transparent text-cream transition hover:bg-caramel/20 hover:text-caramel disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-cream">
                                                    <i class="fa-solid fa-minus text-xs"></i>
                                                </button>
                                            </form>

                                            <span class="min-w-10 text-center text-sm font-semibold text-cream" aria-live="polite">@l.Quantity</span>

                                            <form asp-controller="Cart" asp-action="Update" method="post">
                                                <input type="hidden" name="key" value="@l.Key" />
                                                <input type="hidden" name="quantity" value="@(l.Quantity + 1)" />
                                                <button type="submit" @(l.Quantity >= 10 ? "disabled" : "")
                                                        aria-label="Increase quantity of @l.Name"
                                                        class="grid size-9 place-items-center bg-transparent text-cream transition hover:bg-caramel/20 hover:text-caramel disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-cream">
                                                    <i class="fa-solid fa-plus text-xs"></i>
                                                </button>
                                            </form>
                                        </div>

                                        <div class="flex items-center gap-4">
                                            <p class="hidden text-xs text-neutral-400 sm:block">&#8369;@l.UnitPrice.ToString("N2") each</p>
                                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                                <input type="hidden" name="key" value="@l.Key" />
                                                <button type="submit" aria-label="Remove @l.Name"
                                                        class="inline-flex items-center gap-1.5 rounded-full border border-[#e76f51]/30 bg-[#e76f51]/10 px-3 py-1.5 text-xs font-semibold text-[#f4a07a] transition hover:border-[#e76f51]/60 hover:bg-[#e76f51]/20 hover:text-[#ffb59a]">
                                                    <i class="fa-regular fa-trash-can"></i> Remove
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>

                <!-- Order summary -->
                <aside class="h-fit rounded-3xl border border-white/10 bg-card p-6 lg:sticky lg:top-24">
                    <h2 class="font-serif text-xl font-semibold text-cream">Order summary</h2>

                    <dl class="mt-5 space-y-3 text-sm">
                        <div class="flex justify-between text-neutral-300">
                            <dt>Items (@Model.ItemCount)</dt>
                            <dd>&#8369;@Model.Total.ToString("N2")</dd>
                        </div>
                        <div class="flex justify-between text-neutral-300">
                            <dt>Payment</dt>
                            <dd>At pickup</dd>
                        </div>
                    </dl>

                    <div class="mt-5 flex items-baseline justify-between border-t border-white/10 pt-5">
                        <span class="text-neutral-300">Total</span>
                        <span class="text-3xl font-bold text-caramel">&#8369;@Model.Total.ToString("N2")</span>
                    </div>

                    @if (Model.HasStockProblem)
                    {
                        <span class="mt-6 block cursor-not-allowed rounded-full bg-caramel/30 px-8 py-3.5 text-center text-sm font-semibold text-black/70">
                            Fix stock issues to continue
                        </span>
                    }
                    else
                    {
                        <a asp-controller="Checkout" asp-action="Index"
                           class="mt-6 block rounded-full bg-caramel px-8 py-3.5 text-center text-sm font-semibold text-black shadow-lg shadow-caramel/10 transition hover:bg-cream">
                            Choose pickup time <i class="fa-solid fa-arrow-right ms-1 text-xs"></i>
                        </a>
                    }

                    
                    <a asp-controller="Menu" asp-action="Index"
                       class="mt-3 block rounded-full border border-caramel/40 px-8 py-3 text-center text-sm font-semibold text-caramel transition hover:border-caramel hover:bg-caramel/10 hover:text-cream">
                        Add more items
                    </a>

                    <p class="mt-4 flex items-start gap-2 text-xs text-neutral-400">
                        <i class="fa-solid fa-qrcode mt-0.5 text-caramel"></i>
                        You'll get a single-use pickup code after placing your order.
                    </p>
                </aside>
            </div>
        }
    </div>
</div>