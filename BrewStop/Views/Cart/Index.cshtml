@model BrewStop.Models.CartPageViewModel
@{
    ViewData["Title"] = "Your cart";
    var hasLines = Model.Lines.Count > 0;
    var itemLabel = $"{Model.ItemCount} item{(Model.ItemCount == 1 ? "" : "s")}";
    const int maxQty = BrewStop.Services.CartService.MaxQuantity;
    const string stepBtn = "grid size-9 place-items-center bg-transparent text-cream transition hover:bg-caramel/20 hover:text-caramel disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-cream";
    const string actionBtn = "inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-semibold transition";
}

<div class="tw">
    <div class="mx-auto max-w-6xl px-4 pt-24 pb-16">

        <partial name="~/Views/Checkout/_CheckoutSteps.cshtml" model="0" />

        <div id="cart-root" data-count="@Model.ItemCount" class="transition-opacity">

            <!-- Header -->
            <header class="mt-8 flex flex-wrap items-end justify-between gap-4 border-b border-white/10 pb-5">
                <div class="flex items-center gap-4">
                    <div class="grid size-14 shrink-0 place-items-center rounded-2xl bg-caramel/10 text-2xl text-caramel ring-1 ring-caramel/30">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </div>
                    <div>
                        <h1 class="font-serif text-3xl font-bold text-cream">Your Coffee Selection</h1>
                        <p class="mt-1 text-sm text-neutral-400">Almost ready to brew &mdash; review your picks and we'll have them waiting at the counter.</p>
                    </div>
                </div>
                @if (hasLines)
                {
                    <span id="cart-count-badge" class="inline-flex items-center gap-2 rounded-full border border-caramel/30 bg-caramel/10 px-3.5 py-1.5 text-sm font-semibold text-caramel">
                        <i class="fa-solid fa-mug-hot text-xs"></i>@itemLabel
                    </span>
                }
            </header>

            @if (TempData["Warning"] is string warn)
            {
                <p class="mt-5 rounded-xl border border-amber-400/40 bg-amber-500/10 p-3 text-sm text-amber-200" role="alert">@warn</p>
            }
            @if (TempData["Success"] is string cartOk)
            {
                <p class="mt-5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-sm text-emerald-300" role="status">@cartOk</p>
            }
            @if (TempData["CartError"] is string cartErr)
            {
                <div class="mt-5 flex items-start gap-3 rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200" role="alert">
                    <i class="fa-solid fa-circle-exclamation mt-0.5"></i><span>@cartErr</span>
                </div>
            }

            @if (!hasLines)
            {
                <!-- Empty state -->
                <div class="mt-8 rounded-3xl border border-white/10 bg-card px-6 py-16 text-center">
                    <div class="relative mx-auto grid size-28 place-items-center rounded-full bg-caramel/10 ring-1 ring-caramel/20">
                        <i class="fa-solid fa-mug-hot text-5xl text-caramel"></i>
                        <i class="fa-solid fa-wind absolute -top-1 right-5 -rotate-12 text-sm text-caramel/50"></i>
                        <i class="fa-solid fa-wind absolute -top-3 right-11 -rotate-12 text-xs text-caramel/30"></i>
                    </div>
                    <h2 class="mt-6 font-serif text-2xl font-semibold text-cream">Your cart is empty</h2>
                    <p class="mx-auto mt-2 max-w-sm text-sm text-neutral-400">
                        Nothing brewing yet. Pick a drink or a fresh pastry and skip the queue at pickup.
                    </p>
                    <a asp-controller="Menu" asp-action="Index"
                       class="mt-7 inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-caramel to-[#e9c46a] px-8 py-3 text-sm font-semibold text-black shadow-lg shadow-caramel/20 transition hover:brightness-110">
                        Explore Menu <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                </div>
            }
            else
            {
                @if (Model.HasStockProblem)
                {
                    <div class="mt-5 flex items-start gap-3 rounded-2xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200" role="alert">
                        <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
                        <span>
                            @(Model.HasSoldOut
                                ? "Some items are out of stock. Remove them or adjust quantities to continue to checkout."
                                : "Some items exceed the stock we have left. Lower the quantity to continue to checkout.")
                        </span>
                    </div>
                }

                <div class="mt-6 grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">

                    <!-- Left column -->
                    <div class="min-w-0 space-y-10">

                        <!-- Cart items -->
                        <ul class="space-y-4">
                            @foreach (var l in Model.Lines)
                            {
                                var soldOut = l.StockLeft <= 0;
                                var itemQty = Model.Lines.Where(x => x.MenuItemId == l.MenuItemId).Sum(x => x.Quantity);
                                var plusDisabled = l.Quantity >= maxQty || itemQty >= l.StockLeft;
                                var isFav = Model.FavoriteIds.Contains(l.MenuItemId);
                                var hasDesc = Model.Descriptions.TryGetValue(l.MenuItemId, out var desc) && !string.IsNullOrWhiteSpace(desc);

                                <li class="rounded-3xl border @(l.ExceedsStock ? "border-red-500/40" : "border-white/10") bg-card p-4 sm:p-5">
                                    <div class="flex gap-4">
                                        <div class="relative size-24 shrink-0 overflow-hidden rounded-2xl bg-espresso ring-2 ring-caramel/30 sm:size-28">
                                            <img src="@l.ImageUrl" alt="@l.Name" loading="lazy"
                                                 class="size-full object-cover @(soldOut ? "grayscale opacity-50" : "")" />
                                            @if (soldOut)
                                            {
                                                <span class="absolute inset-0 grid place-items-center bg-black/50 text-[11px] font-bold uppercase tracking-wider text-cream">Sold out</span>
                                            }
                                        </div>

                                        <div class="flex min-w-0 flex-1 flex-col">
                                            <div class="flex items-start justify-between gap-3">
                                                <div class="min-w-0">
                                                    <h3 class="truncate font-serif text-lg font-semibold text-cream">@l.Name</h3>
                                                    @if (hasDesc)
                                                    {
                                                        <p class="mt-0.5 line-clamp-1 text-xs text-neutral-400">@desc</p>
                                                    }
                                                    <div class="mt-2 flex flex-wrap gap-1.5">
                                                        @if (l.SizeName is not null)
                                                        {
                                                            <span class="rounded-full bg-white/5 px-2.5 py-0.5 text-xs text-neutral-300">@l.SizeName</span>
                                                        }
                                                        @foreach (var a in l.AddOns)
                                                        {
                                                            <span class="rounded-full bg-caramel/10 px-2.5 py-0.5 text-xs text-caramel">+ @a.Name</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="shrink-0 text-right">
                                                    <p class="text-lg font-bold text-cream">&#8369;@l.LineTotal.ToString("N2")</p>
                                                    <p class="mt-0.5 text-xs text-neutral-400">&#8369;@l.UnitPrice.ToString("N2") each</p>
                                                </div>
                                            </div>

                                            @if (soldOut)
                                            {
                                                <p class="mt-2 flex items-center gap-1.5 text-xs text-red-300">
                                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                                    This item is out of stock. Remove it to continue.
                                                </p>
                                            }
                                            else if (l.ExceedsStock)
                                            {
                                                <p class="mt-2 flex items-center gap-1.5 text-xs text-red-300">
                                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                                    Only @l.StockLeft left in stock. Lower the quantity to continue.
                                                </p>
                                            }

                                            <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-4">
                                                <!-- Quantity stepper -->
                                                <div class="inline-flex items-center overflow-hidden rounded-full border border-white/15">
                                                    <form asp-controller="Cart" asp-action="Update" method="post" data-cart-form>
                                                        <input type="hidden" name="key" value="@l.Key" />
                                                        <input type="hidden" name="quantity" value="@(l.Quantity - 1)" />
                                                        <button type="submit" disabled="@(l.Quantity <= 1)"
                                                                data-focus-id="dec-@l.Key"
                                                                aria-label="Decrease quantity of @l.Name"
                                                                class="@stepBtn">
                                                            <i class="fa-solid fa-minus text-xs"></i>
                                                        </button>
                                                    </form>

                                                    <span class="min-w-10 text-center text-sm font-semibold text-cream" aria-live="polite">@l.Quantity</span>

                                                    <form asp-controller="Cart" asp-action="Update" method="post" data-cart-form>
                                                        <input type="hidden" name="key" value="@l.Key" />
                                                        <input type="hidden" name="quantity" value="@(l.Quantity + 1)" />
                                                        <button type="submit" disabled="@plusDisabled"
                                                                data-focus-id="inc-@l.Key"
                                                                aria-label="Increase quantity of @l.Name"
                                                                class="@stepBtn">
                                                            <i class="fa-solid fa-plus text-xs"></i>
                                                        </button>
                                                    </form>
                                                </div>

                                                <div class="flex flex-wrap items-center gap-2">
                                                    @if (Model.CanFavorite)
                                                    {
                                                        <form asp-controller="Favorites" asp-action="Toggle" method="post" data-fav-form>
                                                            <input type="hidden" name="menuItemId" value="@l.MenuItemId" />
                                                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Cart")" />
                                                            <button type="submit" data-fav-btn data-saved="@(isFav ? "true" : "false")"
                                                                    aria-pressed="@(isFav ? "true" : "false")"
                                                                    class="group @actionBtn border-white/15 text-neutral-300 hover:border-caramel/60 hover:text-caramel data-[saved=true]:border-caramel/60 data-[saved=true]:bg-caramel/15 data-[saved=true]:text-caramel">
                                                                <i class="fa-regular fa-heart group-data-[saved=true]:hidden"></i>
                                                                <i class="fa-solid fa-heart hidden group-data-[saved=true]:inline-block"></i>
                                                                <span class="group-data-[saved=true]:hidden">Save to favorites</span>
                                                                <span class="hidden group-data-[saved=true]:inline">Saved</span>
                                                            </button>
                                                        </form>
                                                    }
                                                    else if (!Model.IsAuthenticated)
                                                    {
                                                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Cart")"
                                                           class="@actionBtn border-white/15 text-neutral-300 hover:border-caramel/60 hover:text-caramel">
                                                            <i class="fa-regular fa-heart"></i> Save to favorites
                                                        </a>
                                                    }

                                                    <form asp-controller="Cart" asp-action="Remove" method="post" data-cart-form data-confirm-remove="@l.Name">
                                                        <input type="hidden" name="key" value="@l.Key" />
                                                        <button type="submit" aria-label="Remove @l.Name"
                                                                class="@actionBtn border-[#e76f51]/30 bg-[#e76f51]/10 text-[#f4a07a] hover:border-[#e76f51]/60 hover:bg-[#e76f51]/20 hover:text-[#ffb59a]">
                                                            <i class="fa-regular fa-trash-can"></i> Remove
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>

                        <!-- You might also like -->
                        @if (Model.Recommendations.Count > 0)
                        {
                            <section aria-labelledby="rec-heading">
                                <div class="flex items-end justify-between gap-3">
                                    <div>
                                        <h2 id="rec-heading" class="font-serif text-2xl font-semibold text-cream">You Might Also Like</h2>
                                        <p class="mt-1 text-sm text-neutral-400">Fresh from the counter and ready to pair with your order.</p>
                                    </div>
                                </div>

                                <ul class="mt-5 grid grid-cols-2 gap-4 md:grid-cols-4">
                                    @foreach (var r in Model.Recommendations)
                                    {
                                        <li class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-card transition hover:border-caramel/40">
                                            <div class="aspect-[4/3] overflow-hidden bg-espresso">
                                                <img src="@r.ImageUrl" alt="@r.Name" loading="lazy"
                                                     class="size-full object-cover transition duration-300 group-hover:scale-105" />
                                            </div>
                                            <div class="flex flex-1 flex-col p-3">
                                                <p class="text-[10px] font-semibold uppercase tracking-wider text-caramel">@r.CategoryName</p>
                                                <h3 class="mt-0.5 line-clamp-1 font-serif text-sm font-semibold text-cream">@r.Name</h3>
                                                @if (!string.IsNullOrWhiteSpace(r.Description))
                                                {
                                                    <p class="mt-1 line-clamp-2 text-xs text-neutral-400">@r.Description</p>
                                                }

                                                <div class="mt-auto pt-3">
                                                    <div class="flex items-center justify-between gap-2">
                                                        <span class="text-sm font-bold text-cream">&#8369;@r.Price.ToString("N2")</span>
                                                        <a asp-controller="Cart" asp-action="Customize" asp-route-id="@r.Id"
                                                           class="text-xs font-semibold text-neutral-400 underline-offset-2 hover:text-caramel hover:underline">Customize</a>
                                                    </div>

                                                    <form asp-controller="Cart" asp-action="Add" method="post" data-cart-form class="mt-2">
                                                        <input type="hidden" name="MenuItemId" value="@r.Id" />
                                                        @if (r.DefaultSizeId is int sizeId)
                                                        {
                                                            <input type="hidden" name="SizeId" value="@sizeId" />
                                                        }
                                                        <input type="hidden" name="Quantity" value="1" />
                                                        <button type="submit" aria-label="Add @r.Name to cart"
                                                                class="flex w-full items-center justify-center gap-1.5 rounded-full bg-caramel px-3 py-2 text-xs font-semibold text-black transition hover:bg-cream">
                                                            <i class="fa-solid fa-plus text-[10px]"></i> Add to Cart
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    </div>

                    <!-- Order summary -->
                    <aside class="h-fit rounded-3xl border border-white/10 bg-card p-6 lg:sticky lg:top-24">
                        <h2 class="font-serif text-xl font-semibold text-cream">Order summary</h2>

                        <!-- Promo code (preview only) -->
                        <div class="mt-5 rounded-2xl border border-white/10 bg-espresso/60 p-4">
                            <p class="text-xs font-semibold uppercase tracking-wider text-cream">Promo code</p>

                            @if (Model.HasPromo)
                            {
                                <div class="mt-3 flex items-center justify-between gap-3 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3 py-2.5">
                                    <div class="min-w-0">
                                        <p class="flex items-center gap-2 text-sm font-semibold text-emerald-300">
                                            <i class="fa-solid fa-circle-check"></i><span class="truncate">@Model.PromoCode</span>
                                        </p>
                                        <p class="mt-0.5 truncate text-xs text-emerald-200/80">@Model.PromoTitle</p>
                                    </div>
                                    <form asp-controller="Cart" asp-action="RemovePromo" method="post" data-cart-form>
                                        <button type="submit" class="shrink-0 text-xs font-semibold text-neutral-300 underline underline-offset-2 hover:text-cream">Remove</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <form asp-controller="Cart" asp-action="ApplyPromo" method="post" data-cart-form class="mt-3 flex gap-2">
                                    <label for="promoCode" class="sr-only">Promo code</label>
                                    <input id="promoCode" name="promoCode" maxlength="30" autocomplete="off" placeholder="e.g. BREW10"
                                           class="min-w-0 flex-1 rounded-xl border border-white/15 bg-transparent px-3 py-2.5 text-sm uppercase text-cream placeholder:normal-case placeholder:text-neutral-500 focus:border-caramel focus:outline-none" />
                                    <button type="submit"
                                            class="rounded-xl border border-caramel/40 bg-caramel/15 px-4 text-sm font-semibold text-caramel transition hover:bg-caramel hover:text-black">
                                        Apply
                                    </button>
                                </form>
                            }

                            @if (Model.PromoError is string promoErr)
                            {
                                <p role="alert" class="mt-2 flex items-start gap-1.5 text-xs text-red-300">
                                    <i class="fa-solid fa-circle-exclamation mt-0.5"></i><span>@promoErr</span>
                                </p>
                            }
                            <p class="mt-2 text-xs text-neutral-500">Preview only &mdash; a code is used when you place your order.</p>
                        </div>

                        <dl class="mt-5 space-y-3 text-sm">
                            <div class="flex justify-between text-neutral-300">
                                <dt>Subtotal (@itemLabel)</dt>
                                <dd>&#8369;@Model.Total.ToString("N2")</dd>
                            </div>
                            <div class="flex justify-between @(Model.HasPromo ? "text-emerald-300" : "text-neutral-400")">
                                <dt>@(Model.HasPromo ? $"Promo ({Model.PromoCode})" : "Promo discount")</dt>
                                <dd>@(Model.HasPromo ? $"\u2212\u20B1{Model.Discount:N2}" : "\u2014")</dd>
                            </div>
                            <div class="flex justify-between text-neutral-300">
                                <dt>Payment</dt>
                                <dd>Cash or GCash at pickup</dd>
                            </div>
                        </dl>

                        <div class="mt-5 flex items-baseline justify-between border-t border-white/10 pt-5">
                            <span class="text-neutral-300">Estimated total</span>
                            <span class="text-3xl font-bold text-caramel">&#8369;@Model.EstimatedTotal.ToString("N2")</span>
                        </div>
                        <p class="mt-1 text-right text-xs text-neutral-500">Final amount is confirmed at checkout</p>

                        @if (Model.HasStockProblem)
                        {
                            <button type="button" disabled
                                    class="mt-6 block w-full cursor-not-allowed rounded-full bg-caramel/30 px-8 py-3.5 text-center text-sm font-semibold text-black/70">
                                Fix stock issues to continue
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Checkout" asp-action="Index"
                               class="mt-6 block rounded-full bg-gradient-to-r from-caramel to-[#e9c46a] px-8 py-3.5 text-center text-sm font-semibold text-black shadow-lg shadow-caramel/20 transition hover:brightness-110">
                                Proceed to Checkout <i class="fa-solid fa-arrow-right ms-1 text-xs"></i>
                            </a>
                        }

                        <a asp-controller="Menu" asp-action="Index"
                           class="mt-3 block rounded-full border border-caramel/40 px-8 py-3 text-center text-sm font-semibold text-caramel transition hover:border-caramel hover:bg-caramel/10 hover:text-cream">
                            Continue Shopping
                        </a>

                        <p class="mt-4 flex items-start gap-2 text-xs text-neutral-400">
                            <i class="fa-solid fa-qrcode mt-0.5 text-caramel"></i>
                            You'll get a single-use pickup code after placing your order.
                        </p>
                    </aside>
                </div>
            }
        </div>

        <div id="cart-live" class="sr-only" role="status" aria-live="polite"></div>

        <!-- Remove confirmation -->
        <dialog id="remove-dialog" aria-labelledby="remove-title"
                class="m-auto w-[calc(100%-2rem)] max-w-sm rounded-3xl border border-white/10 bg-card p-6 text-cream shadow-2xl backdrop:bg-black/70">
            <div class="grid size-12 place-items-center rounded-full bg-[#e76f51]/15 text-lg text-[#f4a07a]">
                <i class="fa-regular fa-trash-can"></i>
            </div>
            <h2 id="remove-title" class="mt-4 font-serif text-xl font-semibold text-cream">Remove this item?</h2>
            <p class="mt-1 text-sm text-neutral-400">
                <span id="remove-name" class="font-semibold text-cream"></span> will be taken out of your cart.
            </p>
            <div class="mt-6 flex gap-3">
                <button type="button" id="remove-cancel"
                        class="flex-1 rounded-full border border-white/15 px-4 py-2.5 text-sm font-semibold text-cream transition hover:border-caramel hover:text-caramel">
                    Keep it
                </button>
                <button type="button" id="remove-confirm"
                        class="flex-1 rounded-full bg-[#e76f51] px-4 py-2.5 text-sm font-semibold text-black transition hover:bg-[#f4a07a]">
                    Remove
                </button>
            </div>
        </dialog>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var dialog = document.getElementById('remove-dialog');
            var nameEl = document.getElementById('remove-name');
            var live = document.getElementById('cart-live');
            var pending = null;
            var busy = false;

            function root() { return document.getElementById('cart-root'); }

            function syncHeaderBadge(n) {
                var link = document.querySelector('a[aria-label^="Cart ("]');
                if (!link) return;
                link.setAttribute('aria-label', 'Cart (' + n + ' items)');
                var badge = link.querySelector('span');
                if (!badge) return;
                badge.textContent = n;
                badge.style.display = n > 0 ? '' : 'none';
            }

            async function submitCartForm(form) {
                if (busy) return;
                busy = true;

                var r = root();
                var active = document.activeElement;
                var focusId = active && active.dataset ? active.dataset.focusId : null;
                r.classList.add('opacity-60');

                try {
                    var res = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        credentials: 'same-origin'
                    });
                    if (!res.ok) { HTMLFormElement.prototype.submit.call(form); return; }

                    var html = await res.text();
                    var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('cart-root');
                    if (!fresh) { window.location.assign(res.url); return; }

                    r.innerHTML = fresh.innerHTML;
                    r.dataset.count = fresh.dataset.count;
                    syncHeaderBadge(parseInt(fresh.dataset.count, 10) || 0);

                    if (focusId) {
                        var next = Array.prototype.find.call(r.querySelectorAll('[data-focus-id]'), function (el) {
                            return el.dataset.focusId === focusId && !el.disabled;
                        });
                        if (next) next.focus();
                    }
                    live.textContent = 'Cart updated';
                } catch (err) {
                    HTMLFormElement.prototype.submit.call(form);
                } finally {
                    r.classList.remove('opacity-60');
                    busy = false;
                }
            }

            async function toggleFavorite(form) {
                var btn = form.querySelector('[data-fav-btn]');
                if (btn.disabled) return;
                btn.disabled = true;

                try {
                    var res = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        credentials: 'same-origin',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    var type = res.headers.get('content-type') || '';
                    if (!res.ok || type.indexOf('application/json') === -1) {
                        HTMLFormElement.prototype.submit.call(form);
                        return;
                    }

                    var data = await res.json();
                    document.querySelectorAll('[data-fav-form]').forEach(function (f) {
                        var idInput = f.querySelector('input[name="menuItemId"]');
                        if (!idInput || idInput.value !== String(data.menuItemId)) return;
                        var b = f.querySelector('[data-fav-btn]');
                        b.dataset.saved = data.saved ? 'true' : 'false';
                        b.setAttribute('aria-pressed', data.saved ? 'true' : 'false');
                    });
                    live.textContent = data.saved ? 'Saved to favorites' : 'Removed from favorites';
                } catch (err) {
                    HTMLFormElement.prototype.submit.call(form);
                } finally {
                    btn.disabled = false;
                }
            }

            document.addEventListener('submit', function (e) {
                var form = e.target;
                if (!(form instanceof HTMLFormElement)) return;

                if (form.hasAttribute('data-fav-form')) {
                    e.preventDefault();
                    toggleFavorite(form);
                    return;
                }

                if (!form.hasAttribute('data-cart-form')) return;
                e.preventDefault();

                var itemName = form.getAttribute('data-confirm-remove');
                if (itemName !== null) {
                    if (dialog && typeof dialog.showModal === 'function') {
                        pending = form;
                        nameEl.textContent = itemName;
                        dialog.showModal();
                        document.getElementById('remove-cancel').focus();
                    } else if (window.confirm('Remove ' + itemName + ' from your cart?')) {
                        submitCartForm(form);
                    }
                    return;
                }

                submitCartForm(form);
            });

            document.getElementById('remove-cancel').addEventListener('click', function () {
                pending = null;
                dialog.close();
            });

            document.getElementById('remove-confirm').addEventListener('click', function () {
                var form = pending;
                pending = null;
                dialog.close();
                if (form) submitCartForm(form);
            });

            dialog.addEventListener('close', function () { pending = null; });
        })();
    </script>
}