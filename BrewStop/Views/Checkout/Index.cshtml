@model BrewStop.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    var isGcash = Model.Input.PaymentMethod == PaymentMethod.GCash;
    const string label = "mb-2 block text-sm font-semibold uppercase tracking-wider text-cream";
    const string field = "w-full rounded-xl border border-white/15 bg-transparent px-3 py-3 text-cream placeholder:text-neutral-500 focus:border-caramel focus:outline-none";
    const string chip = "block rounded-xl border border-white/15 py-2 text-center text-sm text-cream transition hover:border-caramel peer-checked:border-caramel peer-checked:bg-caramel peer-checked:font-semibold peer-checked:text-black peer-focus-visible:ring-2 peer-focus-visible:ring-caramel";
    const string payCard = "flex items-center gap-3 rounded-2xl border border-white/15 p-4 transition hover:border-caramel peer-checked:border-caramel peer-checked:bg-caramel/10 peer-focus-visible:ring-2 peer-focus-visible:ring-caramel";
}

<div class="tw">
    <div class="mx-auto max-w-3xl px-4 pt-24 pb-12">
        <a asp-controller="Cart" asp-action="Index" class="text-sm font-semibold text-caramel hover:text-cream">&larr; Back to cart</a>
        <h1 class="mt-2 font-serif text-3xl font-bold text-cream">Checkout</h1>

        <section class="mt-6 rounded-3xl border border-white/10 bg-card p-5 sm:p-6">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-cream">Order summary</h2>
            <ul class="mt-3 divide-y divide-white/10">
                @foreach (var l in Model.Cart.Lines)
                {
                    <li class="flex items-start justify-between gap-4 py-3 text-sm">
                        <div class="flex min-w-0 items-start gap-3">
                            <img src="@l.ImageUrl" alt="@l.Name" class="size-14 shrink-0 rounded-lg object-cover" />
                            <div class="min-w-0">
                                <p class="text-cream">@l.Quantity &times; @l.Name</p>
                                <p class="text-xs text-neutral-400">
                                    @(l.SizeName ?? "")@(l.SizeName is not null && l.AddOns.Count > 0 ? " · " : "")@string.Join(", ", l.AddOns.Select(a => a.Name))
                                </p>
                            </div>
                        </div>
                        <span class="shrink-0 text-cream">&#8369;@l.LineTotal.ToString("N2")</span>
                    </li>
                }
            </ul>
            <dl class="mt-3 space-y-1 border-t border-white/10 pt-3 text-sm">
                <div class="flex justify-between text-neutral-300"><dt>Subtotal</dt><dd>&#8369;@Model.Cart.Total.ToString("N2")</dd></div>
                <div class="flex justify-between text-neutral-400"><dt>Promo discount</dt><dd>Calculated on order</dd></div>
                <div class="flex items-baseline justify-between pt-2">
                    <dt class="text-neutral-300">Grand total</dt>
                    <dd class="text-xl font-bold text-caramel">&#8369;@Model.Cart.Total.ToString("N2")</dd>
                </div>
            </dl>
        </section>

        <form asp-controller="Checkout" asp-action="Place" method="post"
              class="mt-6 space-y-7 rounded-3xl border border-white/10 bg-card p-5 sm:p-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-300"></div>

            <!-- Pickup slot -->
            <fieldset>
                <legend class="@label">Pickup time <span class="font-normal normal-case text-neutral-400">(10-minute slots)</span></legend>
                @if (Model.Slots.Count == 0)
                {
                    <p class="rounded-lg border border-yellow-500/40 bg-yellow-500/10 px-4 py-3 text-sm text-yellow-200">
                        No pickup times are available right now. The shop may be closed &mdash; please try again during opening hours.
                    </p>
                }
                else
                {
                    <div class="grid max-h-56 grid-cols-3 gap-2 overflow-y-auto pr-1 sm:grid-cols-4">
                        @for (var i = 0; i < Model.Slots.Count; i++)
                        {
                            var s = Model.Slots[i];
                            <label class="cursor-pointer">
                                <input asp-for="Input.PickupSlot" id="slot-@i" type="radio" value="@s.Value" class="peer sr-only" />
                                <span class="@chip">@s.Label</span>
                            </label>
                        }
                    </div>
                }
                <span asp-validation-for="Input.PickupSlot" class="mt-2 block text-sm text-red-300"></span>
            </fieldset>

            <!-- Payment -->
            <fieldset>
                <legend class="@label">Payment method</legend>
                <div class="grid gap-3 sm:grid-cols-2">
                    <label class="cursor-pointer">
                        <input asp-for="Input.PaymentMethod" id="pay-cash" type="radio" value="@PaymentMethod.Cash" class="peer sr-only" />
                        <span class="@payCard">
                            <i class="fa-solid fa-money-bill-wave text-lg text-caramel"></i>
                            <span><span class="block text-sm font-semibold text-cream">Cash</span><span class="block text-xs text-neutral-400">Pay at the counter</span></span>
                        </span>
                    </label>
                    <label class="cursor-pointer">
                        <input asp-for="Input.PaymentMethod" id="pay-gcash" type="radio" value="@PaymentMethod.GCash" class="peer sr-only" />
                        <span class="@payCard">
                            <i class="fa-solid fa-mobile-screen-button text-lg text-caramel"></i>
                            <span><span class="block text-sm font-semibold text-cream">GCash</span><span class="block text-xs text-neutral-400">Verified by barista at pickup</span></span>
                        </span>
                    </label>
                </div>
                <span asp-validation-for="Input.PaymentMethod" class="mt-2 block text-sm text-red-300"></span>

                <div id="gcash-ref-wrap" class="mt-4 @(isGcash ? "" : "hidden")">
                    <label asp-for="Input.PaymentReference" class="@label">GCash reference no. <span class="font-normal normal-case text-neutral-400">(optional)</span></label>
                    <input asp-for="Input.PaymentReference" maxlength="40" autocomplete="off" placeholder="e.g. GC-908172635" class="@field uppercase" />
                    <span asp-validation-for="Input.PaymentReference" class="mt-1 block text-sm text-red-300"></span>
                </div>
            </fieldset>

            <!-- Promo -->
            <div>
                <label asp-for="Input.PromoCode" class="@label">Promo code <span class="font-normal normal-case text-neutral-400">(optional)</span></label>
                <input asp-for="Input.PromoCode" maxlength="30" autocomplete="off" placeholder="e.g. BREW10" class="@field uppercase" />
                <span asp-validation-for="Input.PromoCode" class="mt-1 block text-sm text-red-300"></span>
            </div>

            <!-- Note -->
            <div>
                <label asp-for="Input.Note" class="@label">Note <span class="font-normal normal-case text-neutral-400">(optional)</span></label>
                <textarea asp-for="Input.Note" rows="3" maxlength="200" placeholder="e.g. Less ice, please" class="@field"></textarea>
                <div class="mt-1 flex items-start justify-between gap-3">
                    <span asp-validation-for="Input.Note" class="block text-sm text-red-300"></span>
                    <span class="ml-auto shrink-0 text-xs text-neutral-400"><span id="note-count">0</span>/200</span>
                </div>
            </div>

            <partial name="_Captcha" model="@("checkout")" />

            <button type="submit" disabled="@(Model.Slots.Count == 0)"
                    class="w-full rounded-full bg-caramel px-6 py-3.5 text-sm font-semibold text-black transition hover:bg-cream disabled:cursor-not-allowed disabled:opacity-50">
                Place order &middot; &#8369;@Model.Cart.Total.ToString("N2")
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            var wrap = document.getElementById('gcash-ref-wrap');
            var ref = document.getElementById('Input_PaymentReference');
            document.querySelectorAll('input[name="Input.PaymentMethod"]').forEach(function(r) {
                r.addEventListener('change', function() {
                    if (!r.checked) return;
                    var g = r.value === 'GCash';
                    wrap.classList.toggle('hidden', !g);
                    if (!g) ref.value = '';
                });
            });
            var note = document.getElementById('Input_Note');
            var cnt = document.getElementById('note-count');
            function count() { cnt.textContent = note.value.length; }
            note.addEventListener('input', count);
            count();
        })();
    </script>
}