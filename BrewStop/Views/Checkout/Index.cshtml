@model BrewStop.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="tw">
    <div class="mx-auto max-w-3xl px-4 pt-24 pb-12">
        <a asp-controller="Cart" asp-action="Index" class="text-sm text-caramel hover:underline">&larr; Back to cart</a>
        <h1 class="mt-2 font-serif text-3xl font-bold text-cream">Checkout</h1>

        <div class="mt-6 rounded-2xl border border-white/10 bg-card p-6">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-cream">Order summary</h2>
            <ul class="mt-3 divide-y divide-white/10">
                @foreach (var l in Model.Cart.Lines)
                {
                    
                    <li class="flex items-start justify-between gap-4 py-3 text-sm">
                        <div class="flex items-start gap-3">
                            <img src="@l.ImageUrl" alt="@l.Name" class="h-14 w-14 rounded-lg object-cover" />
                            <div>
                                <p class="text-cream">@l.Quantity &times; @l.Name</p>
                                <p class="text-xs text-neutral-400">
                                    @(l.SizeName ?? "")@(l.SizeName is not null && l.AddOns.Count > 0 ? " · " : "")@string.Join(", ", l.AddOns.Select(a => a.Name))
                                </p>
                            </div>
                        </div>
                        <span class="text-cream">&#8369;@l.LineTotal.ToString("N2")</span>
                    </li>
                }
            </ul>
            <div class="mt-3 flex items-center justify-between border-t border-white/10 pt-3">
                <span class="text-neutral-300">Total</span>
                <span class="text-xl font-bold text-caramel">&#8369;@Model.Cart.Total.ToString("N2")</span>
            </div>
        </div>

        <form asp-controller="Checkout" asp-action="Place" method="post" class="mt-6 space-y-6 rounded-2xl border border-white/10 bg-card p-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-300"></div>

            <div>
                <label asp-for="Input.PickupSlot" class="mb-2 block text-sm font-semibold uppercase tracking-wider text-cream"></label>
                @if (Model.Slots.Count == 0)
                {
                    <p class="rounded-lg border border-yellow-500/40 bg-yellow-500/10 px-4 py-3 text-sm text-yellow-200">
                        No pickup times are available right now. The shop may be closed &mdash; please try again during opening hours.
                    </p>
                }
                else
                {
                    <select asp-for="Input.PickupSlot" class="w-full rounded-lg border border-white/15 bg-[#1a0f0d] px-3 py-3 text-cream">
                        <option value="">Select a pickup time</option>
                        @foreach (var s in Model.Slots)
                        {
                            <option value="@s.Value">@s.Label</option>
                        }
                    </select>
                }
                <span asp-validation-for="Input.PickupSlot" class="mt-1 block text-sm text-red-300"></span>
            </div>

            <div>
                <label asp-for="Input.Note" class="mb-2 block text-sm font-semibold uppercase tracking-wider text-cream">Note (optional)</label>
                <textarea asp-for="Input.Note" rows="3" maxlength="200" placeholder="e.g. Less ice, please"
                          class="w-full rounded-lg border border-white/15 bg-transparent px-3 py-3 text-cream placeholder:text-neutral-500"></textarea>
                <span asp-validation-for="Input.Note" class="mt-1 block text-sm text-red-300"></span>
                <p class="mt-1 text-xs text-neutral-400">Max 200 characters. Letters, numbers and basic punctuation only.</p>
            </div>

            <p class="text-xs text-neutral-400">Payment is made at pickup.</p>
            <partial name="_Captcha" model='"checkout"' />
            <button type="submit" disabled="@(Model.Slots.Count == 0)"
                    class="w-full rounded-full bg-caramel px-6 py-3 text-sm font-semibold text-black hover:bg-cream disabled:cursor-not-allowed disabled:opacity-50">
                Place order
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}