@model List<BrewStop.Models.MenuItemDto>
@{
    ViewData["Title"] = "My Favorites";
}

<div class="tw">
    <div class="mx-auto max-w-6xl px-4 pt-24 pb-16">
        <div class="flex items-end justify-between border-b border-white/10 pb-4">
            <h1 class="font-serif text-3xl font-bold text-cream">My Favorites</h1>
            @if (Model.Count > 0)
            {
                <span class="text-sm text-neutral-400">@Model.Count saved</span>
            }
        </div>

        @if (TempData["FavSuccess"] is string ok)
        {
            <p class="mt-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-sm text-emerald-300" role="status">@ok</p>
        }
        @if (TempData["FavError"] is string fe)
        {
            <p class="mt-4 rounded-xl border border-red-500/40 bg-red-500/10 p-3 text-sm text-red-200" role="alert">@fe</p>
        }

        @if (Model.Count == 0)
        {
            <div class="mt-8 rounded-3xl border border-white/10 bg-card px-6 py-16 text-center">
                <div class="mx-auto grid size-20 place-items-center rounded-full bg-rose-500/10 text-3xl text-rose-400">
                    <i class="fa-regular fa-heart"></i>
                </div>
                <h2 class="mt-5 font-serif text-xl font-semibold text-cream">No favorites yet</h2>
                <p class="mt-1 text-sm text-neutral-400">Tap the heart on any drink or pastry to save it here.</p>
                <a asp-controller="Menu" asp-action="Index"
                   class="mt-6 inline-block rounded-full bg-caramel px-8 py-3 text-sm font-semibold text-black transition hover:bg-cream">Browse the menu</a>
            </div>
        }
        else
        {
            <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var item in Model)
                {
                    <article class="flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-card">
                        <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id"
                           class="relative block aspect-[4/3] overflow-hidden bg-espresso">
                            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" referrerpolicy="no-referrer"
                                 class="size-full object-cover @(item.IsAvailable ? "" : "grayscale opacity-60")"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/images/placeholder.svg")'" />
                            @if (!item.IsAvailable)
                            {
                                <span class="absolute left-3 top-3 rounded-full bg-red-600 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">Out of stock</span>
                            }
                        </a>

                        <div class="flex flex-1 flex-col p-5">
                            <div class="flex items-start justify-between gap-3">
                                <h2 class="font-serif text-lg font-semibold text-cream">
                                    <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id" class="hover:text-caramel">@item.Name</a>
                                </h2>
                                <p class="shrink-0 text-lg font-bold text-caramel">&#8369;@item.Price.ToString("N2")</p>
                            </div>
                            <p class="mt-1 text-xs text-neutral-400">@item.CategoryName</p>
                            <div class="mt-2"><partial name="_RatingBadge" model="item" /></div>

                            <p class="mt-3 text-xs font-semibold @(!item.IsAvailable ? "text-red-300" : item.Stock <= 5 ? "text-yellow-300" : "text-emerald-300")">
                                @if (!item.IsAvailable)
                                {
                                    <text>Out of stock</text>
                                }
                                else if (item.Stock <= 5)
                                {

                                    <text>Only @item.Stock left</text>
                                }
                                else
                                {

                                    <text>In stock</text>
                                }
                            </p>

                            <div class="mt-auto space-y-2 pt-4">
                                <form asp-action="QuickAdd" method="post">
                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                    <button type="submit" disabled="@(!item.IsAvailable)"
                                            class="w-full rounded-full bg-caramel px-5 py-2.5 text-sm font-semibold text-black transition hover:bg-cream disabled:cursor-not-allowed disabled:bg-white/10 disabled:text-neutral-500">
                                        <i class="fa-solid fa-bag-shopping me-1"></i> Add to cart
                                    </button>
                                </form>
                                <div class="grid grid-cols-2 gap-2">
                                    @if (item.IsAvailable)
                                    {
                                        <a asp-controller="Cart" asp-action="Customize" asp-route-id="@item.Id"
                                           class="rounded-full border border-caramel/40 px-4 py-2 text-center text-xs font-semibold text-caramel transition hover:border-caramel hover:bg-caramel/10">Customize</a>
                                    }
                                    else
                                    {
                                        <span class="rounded-full border border-white/10 px-4 py-2 text-center text-xs font-semibold text-neutral-500">Customize</span>
                                    }
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="menuItemId" value="@item.Id" />
                                        <button type="submit" aria-label="Remove @item.Name from favorites"
                                                class="w-full rounded-full border border-red-400/40 px-4 py-2 text-xs font-semibold text-red-300 transition hover:bg-red-500/10">
                                            <i class="fa-regular fa-trash-can me-1"></i> Remove
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>