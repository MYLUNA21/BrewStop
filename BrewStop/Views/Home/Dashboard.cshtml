@model BrewStop.Models.DashboardViewModel
@inject BrewStop.Services.IImageResolver Images
@inject BrewStop.Services.IPickupSlotService Slots
@{
    ViewData["Title"] = "Home";
    ViewData["LiveReload"] = false;

    const string whenFmt = "ddd, MMM d \u00B7 h:mm tt";
    const string sectionTitle = "font-serif text-2xl font-semibold text-cream";
    const string chip = "rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-[11px] font-medium text-neutral-300";
}

<div class="tw">
    <div class="mx-auto max-w-6xl px-4 pt-24 pb-16">

        <!-- 1. Hero -->
        <section class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-card via-espresso to-card" aria-labelledby="hero-title">
            <div class="pointer-events-none absolute -left-24 -top-24 size-80 rounded-full bg-caramel/15 blur-3xl"></div>

            <div class="relative grid lg:grid-cols-2">
                <div class="flex flex-col justify-center px-6 py-12 sm:px-10 lg:px-12 lg:py-16">
                    <p class="text-xs font-bold uppercase tracking-[0.25em] text-caramel">Your campus coffee experience</p>
                    <p class="mt-5 text-lg text-neutral-300">@Model.Greeting, <span class="font-semibold text-cream">@Model.FirstName</span></p>
                    <h1 id="hero-title" class="mt-2 font-serif text-4xl font-bold leading-tight tracking-tight text-cream sm:text-5xl">
                        Your daily <span class="text-caramel">coffee ritual</span> starts here.
                    </h1>
                    <p class="mt-5 max-w-md text-base text-neutral-400">
                        Order ahead, skip the line, and pick up your handcrafted drinks and fresh pastries right on campus.
                    </p>
                    <div class="mt-8 flex flex-wrap gap-3">
                        <a asp-controller="Menu" asp-action="Index"
                           class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-caramel to-[#e9c46a] px-8 py-3.5 text-sm font-semibold text-black shadow-lg shadow-caramel/20 transition hover:brightness-110">
                            Order Your Coffee <i class="fa-solid fa-arrow-right text-xs"></i>
                        </a>
                        <a asp-controller="Order" asp-action="Index"
                           class="rounded-full border border-white/15 px-8 py-3.5 text-sm font-semibold text-cream transition hover:border-caramel hover:text-caramel">
                            My Orders
                        </a>
                    </div>
                </div>

                <div class="relative min-h-[260px] lg:min-h-full">
                    <img src="@Model.HeroImageUrl" alt="" loading="eager" class="absolute inset-0 size-full object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-t from-card via-card/30 to-transparent lg:bg-gradient-to-r"></div>
                    <div class="absolute inset-0 bg-caramel/10 mix-blend-soft-light"></div>
                </div>
            </div>
        </section>

        <!-- 2. Account overview -->
        <section class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4" aria-label="Account overview">
            <div class="rounded-3xl border border-white/10 bg-card p-5">
                <div class="grid size-10 place-items-center rounded-xl bg-caramel/10 text-caramel"><i class="fa-solid fa-receipt"></i></div>
                <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-neutral-400">Total Orders</p>
                <p class="mt-1 font-serif text-3xl font-bold text-cream">@Model.TotalOrders</p>
            </div>

            <div class="rounded-3xl border border-white/10 bg-card p-5">
                <div class="grid size-10 place-items-center rounded-xl bg-caramel/10 text-caramel"><i class="fa-solid fa-star"></i></div>
                <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-neutral-400">Reward Points</p>
                <p class="mt-1 font-serif text-3xl font-bold text-caramel">@Model.Points.ToString("N0")</p>
            </div>

            <div class="rounded-3xl border border-white/10 bg-card p-5">
                <div class="grid size-10 place-items-center rounded-xl bg-caramel/10 text-caramel"><i class="fa-solid fa-heart"></i></div>
                <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-neutral-400">Favorite Items</p>
                <p class="mt-1 font-serif text-3xl font-bold text-cream">@Model.FavoriteCount</p>
            </div>

            <div class="rounded-3xl border border-white/10 bg-card p-5">
                <div class="grid size-10 place-items-center rounded-xl bg-caramel/10 text-caramel"><i class="fa-regular fa-calendar"></i></div>
                <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-neutral-400">Last Order</p>
                @if (Model.LastOrderLocal is DateTime lastOrder)
                {
                    <p class="mt-1 font-serif text-xl font-bold text-cream">@lastOrder.ToString("MMM d, yyyy")</p>
                    <p class="text-xs text-neutral-400">@lastOrder.ToString("h:mm tt")</p>
                }
                else
                {
                    <p class="mt-1 font-serif text-xl font-bold text-neutral-500">&mdash;</p>
                    <p class="text-xs text-neutral-500">No orders yet</p>
                }
            </div>
        </section>

        <!-- 3. Active order -->
        <section class="mt-12" aria-labelledby="active-heading">
            <div class="flex flex-wrap items-end justify-between gap-3">
                <h2 id="active-heading" class="@sectionTitle">Your Active Order@(Model.ActiveCount > 1 ? "s" : "")</h2>
                @if (Model.ActiveCount > 0)
                {
                    <a asp-controller="Order" asp-action="Index" class="text-sm font-semibold text-caramel transition hover:text-cream">View all orders &rarr;</a>
                }
            </div>

            @if (Model.ActiveOrders.Count == 0)
            {
                <div class="mt-4 flex flex-wrap items-center justify-between gap-5 rounded-3xl border border-dashed border-white/15 bg-card/60 px-6 py-8">
                    <div class="flex items-center gap-4">
                        <div class="grid size-14 shrink-0 place-items-center rounded-full bg-caramel/10 text-2xl text-caramel"><i class="fa-solid fa-mug-hot"></i></div>
                        <p class="max-w-md text-sm text-neutral-300">No active orders right now. Ready for another cup of coffee?</p>
                    </div>
                    <a asp-controller="Menu" asp-action="Index"
                       class="rounded-full bg-caramel px-6 py-2.5 text-sm font-semibold text-black transition hover:bg-cream">Browse Our Menu</a>
                </div>
            }
            else
            {
                <div class="mt-4 space-y-5">
                    @foreach (var o in Model.ActiveOrders)
                    {
                        var local = Slots.ToLocal(o.PickupAtUtc);
                        var shown = o.Items.Take(3).ToList();
                        var more = o.Items.Count - shown.Count;
                        var statusMsg = o.Status switch
                        {
                            OrderStatus.Placed => "We've got your order. A barista will start on it shortly.",
                            OrderStatus.Preparing => "Your order is being handcrafted right now.",
                            OrderStatus.Ready => "Ready for pickup! Show your QR code at the counter.",
                            _ => string.Empty
                        };

                        <article class="rounded-3xl border border-caramel/30 bg-card p-5 shadow-lg shadow-black/20 sm:p-6">
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex min-w-0 flex-wrap items-center gap-2.5">
                                    <h3 class="font-serif text-xl font-semibold text-cream">Order #@o.Id</h3>
                                    <partial name="~/Views/Order/_StatusBadge.cshtml" model="o" />
                                </div>
                                <p class="shrink-0 text-xl font-bold text-caramel">&#8369;@o.Total.ToString("N2")</p>
                            </div>

                            <p data-order-message="@o.Id" class="mt-2 flex items-start gap-2 text-sm text-neutral-300">
                                <i class="fa-solid fa-bell-concierge mt-0.5 text-caramel"></i>
                                <span>@statusMsg</span>
                            </p>

                            <div class="mt-4 flex gap-4">
                                <div class="flex shrink-0 -space-x-4 self-start">
                                    @foreach (var i in shown)
                                    {
                                        <img src="@Images.Resolve(i.MenuItem?.ImageUrl, i.ItemName)" alt="@i.ItemName" loading="lazy"
                                             class="size-16 rounded-2xl object-cover ring-2 ring-card sm:size-20" />
                                    }
                                    @if (more > 0)
                                    {
                                        <span class="grid size-16 place-items-center rounded-2xl bg-espresso text-xs font-bold text-caramel ring-2 ring-card sm:size-20">+@more</span>
                                    }
                                </div>

                                <ul class="min-w-0 flex-1 space-y-2">
                                    @foreach (var i in o.Items)
                                    {
                                        <li class="min-w-0">
                                            <p class="truncate text-sm font-semibold text-cream">@i.Quantity&times; @i.ItemName</p>
                                            @if (i.SizeName is not null || i.AddOns.Count > 0)
                                            {
                                                <div class="mt-1 flex flex-wrap gap-1.5">
                                                    @if (i.SizeName is not null)
                                                    {
                                                        <span class="rounded-full bg-white/5 px-2 py-0.5 text-[11px] text-neutral-300">@i.SizeName</span>
                                                    }
                                                    @foreach (var a in i.AddOns)
                                                    {
                                                        <span class="rounded-full bg-caramel/10 px-2 py-0.5 text-[11px] text-caramel">+ @a.Name</span>
                                                    }
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>

                            <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-xs text-neutral-400">
                                <div><dt class="inline">Ready by: </dt><dd class="inline text-cream">@local.ToString(whenFmt)</dd></div>
                                <div><dt class="inline">Payment: </dt><dd class="inline text-cream">@o.PaymentMethod</dd></div>
                            </dl>

                            <div class="mt-5 border-t border-white/10 pt-5">
                                <partial name="~/Views/Order/_Progress.cshtml" model="o" />
                            </div>

                            <div class="mt-5 flex justify-end">
                                <a asp-controller="Order" asp-action="Details" asp-route-id="@o.Id"
                                   class="inline-flex items-center gap-2 rounded-full bg-caramel px-6 py-2.5 text-sm font-semibold text-black transition hover:bg-cream">
                                    Track Order <i class="fa-solid fa-arrow-right text-xs"></i>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <!-- 4. Quick actions -->
        <section class="mt-12" aria-labelledby="quick-heading">
            <h2 id="quick-heading" class="@sectionTitle">Quick Actions</h2>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <a asp-controller="Menu" asp-action="Index"
                   class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-card p-5 transition hover:-translate-y-0.5 hover:border-caramel/50">
                    <div class="grid size-12 shrink-0 place-items-center rounded-xl bg-caramel/10 text-lg text-caramel transition group-hover:bg-caramel group-hover:text-black"><i class="fa-solid fa-mug-hot"></i></div>
                    <div class="min-w-0"><p class="font-serif text-base font-semibold text-cream">Order Now</p><p class="text-xs text-neutral-400">Browse drinks and pastries</p></div>
                </a>
                <a asp-controller="Order" asp-action="Index"
                   class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-card p-5 transition hover:-translate-y-0.5 hover:border-caramel/50">
                    <div class="grid size-12 shrink-0 place-items-center rounded-xl bg-caramel/10 text-lg text-caramel transition group-hover:bg-caramel group-hover:text-black"><i class="fa-solid fa-receipt"></i></div>
                    <div class="min-w-0"><p class="font-serif text-base font-semibold text-cream">My Orders</p><p class="text-xs text-neutral-400">Track and reorder</p></div>
                </a>
                <a asp-controller="Favorites" asp-action="Index"
                   class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-card p-5 transition hover:-translate-y-0.5 hover:border-caramel/50">
                    <div class="grid size-12 shrink-0 place-items-center rounded-xl bg-caramel/10 text-lg text-caramel transition group-hover:bg-caramel group-hover:text-black"><i class="fa-solid fa-heart"></i></div>
                    <div class="min-w-0"><p class="font-serif text-base font-semibold text-cream">Favorites</p><p class="text-xs text-neutral-400">Your saved picks</p></div>
                </a>
                <a asp-controller="Account" asp-action="Manage"
                   class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-card p-5 transition hover:-translate-y-0.5 hover:border-caramel/50">
                    <div class="grid size-12 shrink-0 place-items-center rounded-xl bg-caramel/10 text-lg text-caramel transition group-hover:bg-caramel group-hover:text-black"><i class="fa-solid fa-user"></i></div>
                    <div class="min-w-0"><p class="font-serif text-base font-semibold text-cream">My Account</p><p class="text-xs text-neutral-400">Profile and settings</p></div>
                </a>
            </div>
        </section>

        <!-- 5. Popular -->
        @if (Model.Popular.Count > 0)
        {
            <section class="mt-12" aria-labelledby="popular-heading">
                <h2 id="popular-heading" class="@sectionTitle">Popular at BrewStop</h2>
                <p class="mt-1 text-sm text-neutral-400">What the campus is ordering most right now.</p>

                <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var p in Model.Popular)
                    {
                        <li class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-card transition hover:border-caramel/40">
                            <div class="h-52 overflow-hidden bg-espresso">
                                <img src="@p.ImageUrl" alt="@p.Name" loading="lazy"
                                     class="size-full object-cover transition duration-300 group-hover:scale-105" />
                            </div>
                            <div class="flex flex-1 flex-col p-5">
                                <span class="@chip self-start">@p.CategoryName</span>
                                <h3 class="mt-3 font-serif text-xl font-bold text-cream">@p.Name</h3>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <p class="mt-1.5 line-clamp-2 text-sm text-neutral-400">@p.Description</p>
                                }
                                <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                                    <span class="text-lg font-bold text-caramel">&#8369;@p.Price.ToString("N2")</span>
                                    <a asp-controller="Cart" asp-action="Customize" asp-route-id="@p.Id"
                                       class="rounded-full bg-caramel px-5 py-2 text-xs font-semibold text-black transition hover:bg-cream">Order Now</a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }

        <!-- 6. Recommendations -->
        @if (Model.Recommended.Count > 0)
        {
            <section class="mt-12" aria-labelledby="rec-heading">
                <h2 id="rec-heading" class="@sectionTitle">Made for Your Next Coffee Break</h2>
                <p class="mt-1 text-sm text-neutral-400">
                    @(Model.HasHistory ? "Picked from what you love to order." : "More fan favorites from around the caf\u00E9.")
                </p>

                <ul class="mt-5 grid grid-cols-2 gap-4 lg:grid-cols-4">
                    @foreach (var r in Model.Recommended)
                    {
                        <li class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-card transition hover:border-caramel/40">
                            <div class="aspect-[4/3] overflow-hidden bg-espresso">
                                <img src="@r.ImageUrl" alt="@r.Name" loading="lazy"
                                     class="size-full object-cover transition duration-300 group-hover:scale-105" />
                            </div>
                            <div class="flex flex-1 flex-col p-3.5">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-caramel">@r.CategoryName</p>
                                <h3 class="mt-0.5 line-clamp-1 font-serif text-sm font-semibold text-cream">@r.Name</h3>
                                <div class="mt-auto flex items-center justify-between gap-2 pt-3">
                                    <span class="text-sm font-bold text-cream">&#8369;@r.Price.ToString("N2")</span>
                                    <a asp-controller="Cart" asp-action="Customize" asp-route-id="@r.Id"
                                       class="text-xs font-semibold text-caramel transition hover:text-cream">Order now &rarr;</a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }

        <!-- 7. Rewards banner -->
        <section class="relative mt-12 overflow-hidden rounded-3xl border border-caramel/30 bg-gradient-to-br from-caramel/25 via-card to-card p-6 sm:p-10" aria-labelledby="rewards-heading">
            <div class="pointer-events-none absolute -right-10 -top-10 text-[180px] leading-none text-caramel/10"><i class="fa-solid fa-mug-hot"></i></div>

            <div class="relative max-w-2xl">
                <p class="text-xs font-bold uppercase tracking-[0.25em] text-caramel">BrewStop Rewards</p>
                <h2 id="rewards-heading" class="mt-3 font-serif text-3xl font-bold text-cream">Every Cup Brings You Closer to More.</h2>
                <p class="mt-3 text-sm text-neutral-300">
                    You have <span class="font-semibold text-caramel">@Model.Points.ToString("N0") point@(Model.Points == 1 ? "" : "s")</span>.
                    Earn 1 point for every &#8369;@Model.PesosPerPoint.ToString("0") you spend once your order is picked up.
                </p>

                @if (Model.NextReward is not null)
                {
                    var need = Model.NextReward.Cost - Model.Points;
                    <div class="mt-5">
                        <div class="h-2.5 overflow-hidden rounded-full bg-white/10"
                             role="progressbar" aria-valuemin="0" aria-valuemax="@Model.NextReward.Cost" aria-valuenow="@Model.Points"
                             aria-label="Progress to @Model.NextReward.Title">
                            <div class="h-full rounded-full bg-gradient-to-r from-caramel to-[#e9c46a]" style="width:@(Model.ProgressPercent)%"></div>
                        </div>
                        <p class="mt-2 text-xs text-neutral-400">
                            @need more point@(need == 1 ? "" : "s") to reach <span class="font-semibold text-cream">@Model.NextReward.Title</span>
                        </p>
                    </div>
                }
                else if (Model.Points > 0)
                {
                    <p class="mt-4 text-sm font-semibold text-cream">You've reached every reward level. Keep sipping!</p>
                }

                <div class="mt-6 flex flex-wrap gap-3">
                    <a asp-controller="Menu" asp-action="Index"
                       class="rounded-full bg-caramel px-6 py-2.5 text-sm font-semibold text-black transition hover:bg-cream">Explore the Menu</a>
                    <a asp-controller="Favorites" asp-action="Index"
                       class="rounded-full border border-white/15 px-6 py-2.5 text-sm font-semibold text-cream transition hover:border-caramel hover:text-caramel">My Favorites</a>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    @if (Model.ActiveCount > 0)
    {
        <partial name="~/Views/Order/_OrderLive.cshtml" />
        <script>
            (function() {
                var MSG = {
                    Placed: "We've got your order. A barista will start on it shortly.",
                    Preparing: 'Your order is being handcrafted right now.',
                    Ready: 'Ready for pickup! Show your QR code at the counter.',
                    Claimed: 'Picked up. Enjoy your coffee!'
                };
                document.querySelectorAll('[data-order-status]').forEach(function(badge) {
                    new MutationObserver(function() {
                        var wrap = document.querySelector('[data-order-message="' + badge.dataset.orderStatus + '"]');
                        var text = MSG[badge.dataset.status];
                        var span = wrap ? wrap.querySelector('span') : null;
                        if (span && text) span.textContent = text;
                    }).observe(badge, { attributes: true, attributeFilter: ['data-status'] });
                });
            })();
        </script>
    }
}