@model BrewStop.Models.MenuViewModel
@{
    ViewData["Title"] = "Menu";
    var isCustomer = User.IsInRole(AppRoles.Student) || User.IsInRole(AppRoles.Faculty);
    var isBarista = User.IsInRole(AppRoles.Barista);
    var refSizes = (ViewBag.RefSizes as List<BrewStop.Models.ItemSize>) ?? new List<BrewStop.Models.ItemSize>();
    var refAddOns = (ViewBag.RefAddOns as List<BrewStop.Models.AddOn>) ?? new List<BrewStop.Models.AddOn>();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    const string pillBase = "inline-flex shrink-0 items-center gap-1.5 rounded-full border px-4 py-2 text-sm font-semibold transition";
    const string pillOn = "border-caramel bg-caramel text-black";
    const string pillOff = "border-white/15 text-cream hover:border-caramel hover:text-caramel";
}

<div class="tw">
    <div class="mx-auto max-w-6xl px-4 pt-24 pb-16">

        @if (TempData["MenuError"] is string menuErr)
        {
            <div class="mb-4 flex items-start gap-3 rounded-xl border border-yellow-500/40 bg-yellow-500/10 px-4 py-3 text-sm text-yellow-200">
                <i class="fa-solid fa-triangle-exclamation mt-0.5"></i><span>@menuErr</span>
            </div>
        }

        <h1 class="font-serif text-3xl font-bold text-cream">Menu</h1>

        <form method="get" asp-action="Index" role="search" class="relative mt-5">
            <input type="hidden" name="category" value="@Model.ActiveCategory" />
            <label for="menu-search" class="sr-only">Search the menu</label>
            <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-caramel"></i>
            <input id="menu-search" type="search" name="searchTerm" value="@Model.SearchTerm" maxlength="100"
                   autocomplete="off" placeholder="Search drinks or pastries..."
                   class="w-full rounded-full border border-white/15 bg-card py-3 pl-11 pr-24 text-sm text-cream placeholder:text-neutral-500 focus:border-caramel focus:outline-none" />
            <button type="submit"
                    class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-full bg-caramel px-4 py-1.5 text-xs font-semibold text-black transition hover:bg-cream">
                Search
            </button>
        </form>

        <nav aria-label="Menu categories" class="-mx-4 mt-4 flex gap-2 overflow-x-auto px-4 pb-1">
            <a data-pill asp-action="Index" asp-route-category="all" asp-route-searchTerm="@Model.SearchTerm"
               aria-current="@(Model.ActiveCategory == "all" ? "page" : null)"
               class="@pillBase @(Model.ActiveCategory == "all" ? pillOn : pillOff)">All</a>
            @foreach (var p in Model.Pills)
            {
                var on = string.Equals(Model.ActiveCategory, p.Slug, StringComparison.OrdinalIgnoreCase);
                <a data-pill asp-action="Index" asp-route-category="@p.Slug" asp-route-searchTerm="@Model.SearchTerm"
                   aria-current="@(on ? "page" : null)"
                   class="@pillBase @(on ? pillOn : pillOff)">@p.Name</a>
            }
        </nav>

        <div id="menu-empty" class="@(Model.ResultCount == 0 ? "" : "hidden") mt-8 rounded-3xl border border-white/10 bg-card px-6 py-14 text-center">
            <div class="mx-auto grid size-16 place-items-center rounded-full bg-caramel/10 text-2xl text-caramel">
                <i class="fa-solid fa-mug-saucer"></i>
            </div>
            <h2 class="mt-4 font-serif text-xl font-semibold text-cream">Nothing matches your search</h2>
            <a asp-action="Index" class="mt-4 inline-block text-sm font-semibold text-caramel hover:text-cream">Clear filters</a>
        </div>

        @foreach (var cat in Model.Categories)
        {
            <section data-menu-section class="mt-8" aria-labelledby="cat-@cat.Slug">
                <div class="flex items-center justify-between border-b border-white/10 pb-3">
                    <h2 id="cat-@cat.Slug" class="font-serif text-2xl font-bold text-cream">@cat.Name</h2>
                    <span class="rounded-full bg-white/5 px-3 py-1 text-xs text-neutral-300">
                        @cat.Items.Count(i => i.IsAvailable) available
                    </span>
                </div>

                <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var item in cat.Items)
                    {
                        <article data-menu-card data-search="@((item.Name + " " + item.Description).ToLowerInvariant())"
                                 class="flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-card">
                            <div class="relative aspect-[4/3] overflow-hidden bg-espresso">
                                <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" referrerpolicy="no-referrer"
                                     class="size-full object-cover @(item.IsAvailable ? "" : "grayscale opacity-60")"
                                     onerror="this.onerror=null;this.src='@Url.Content("~/images/placeholder.svg")'" />
                                @if (item.IsAvailable)
                                {
                                    <span class="absolute right-3 top-3 rounded-full bg-black/60 px-3 py-1 text-xs font-semibold text-caramel">@item.BadgeText</span>
                                }
                                else
                                {
                                    <span class="absolute left-3 top-3 rounded-full bg-red-600 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">Out of stock</span>
                                }
                                @if (isCustomer)
                                {
                                    <form asp-controller="Favorites" asp-action="Toggle" method="post" data-fav-form
                                          class="absolute bottom-3 right-3">
                                        <input type="hidden" name="menuItemId" value="@item.Id" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" aria-pressed="@(item.IsFavorite ? "true" : "false")"
                                                aria-label="Favorite @item.Name"
                                                class="grid size-9 place-items-center rounded-full bg-black/60 text-base backdrop-blur transition hover:bg-black/80 @(item.IsFavorite ? "text-rose-400" : "text-white")">
                                            <i class="@(item.IsFavorite ? "fa-solid" : "fa-regular") fa-heart"></i>
                                        </button>
                                    </form>
                                }
                                else if (User.Identity?.IsAuthenticated != true)
                                {
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl"
                                       aria-label="Sign in to save @item.Name"
                                       class="absolute bottom-3 right-3 grid size-9 place-items-center rounded-full bg-black/60 text-base text-white backdrop-blur hover:bg-black/80">
                                        <i class="fa-regular fa-heart"></i>
                                    </a>
                                }
                            </div>

                            <div class="flex flex-1 flex-col p-5">
                                <div class="flex items-start justify-between gap-3">
                                    <h3 class="font-serif text-lg font-semibold text-cream">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="hover:text-caramel">@item.Name</a>
                                    </h3>
                                    <p class="shrink-0 text-lg font-bold text-caramel">&#8369;@item.Price.ToString("N2")</p>
                                </div>
                                <p class="mt-1 text-xs text-neutral-400">@item.CategoryName</p>
                                <div class="mt-1.5"><partial name="_RatingBadge" model="item" /></div>
                                <p class="mt-2 line-clamp-3 text-sm text-neutral-300">@item.Description</p>

                                <div class="mt-auto pt-4">
                                    @if (item.IsAvailable)
                                    {
                                        @if (item.Stock <= 5)
                                        {
                                            <p class="mb-2 text-xs font-semibold text-yellow-300">Only @item.Stock left</p>
                                        }
                                        @if (isBarista)
                                        {
                                            <partial name="_BaristaReference" model="(cat.Group, refSizes, refAddOns)" />
                                        }
                                        else
                                        {
                                            <a asp-controller="Cart" asp-action="Customize" asp-route-id="@item.Id"
                                               class="block rounded-full bg-caramel px-5 py-2.5 text-center text-sm font-semibold text-black transition hover:bg-cream">
                                                <i class="fa-solid fa-mug-hot me-1"></i> Customize &amp; Order
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" disabled aria-disabled="true"
                                                class="w-full cursor-not-allowed rounded-full bg-white/10 px-5 py-2.5 text-sm font-semibold text-neutral-500">
                                            Unavailable
                                        </button>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var input = document.getElementById('menu-search');
            var cards = document.querySelectorAll('[data-menu-card]');
            var sections = document.querySelectorAll('[data-menu-section]');
            var empty = document.getElementById('menu-empty');
            var pills = document.querySelectorAll('[data-pill]');
            var timer;

            function apply() {
                var raw = input.value.trim(), q = raw.toLowerCase(), shown = 0;
                cards.forEach(function(c) {
                    var hit = !q || c.dataset.search.indexOf(q) !== -1;
                    c.classList.toggle('hidden', !hit);
                    if (hit) shown++;
                });
                sections.forEach(function(s) {
                    s.classList.toggle('hidden', !s.querySelector('[data-menu-card]:not(.hidden)'));
                });
                empty.classList.toggle('hidden', shown !== 0);
                pills.forEach(function(a) {
                    var u = new URL(a.href, location.origin);
                    if (raw) u.searchParams.set('searchTerm', raw); else u.searchParams.delete('searchTerm');
                    a.href = u.pathname + u.search;
                });
            }

            input.addEventListener('input', function() { clearTimeout(timer); timer = setTimeout(apply, 120); });
            apply();
        })();
    </script>
}