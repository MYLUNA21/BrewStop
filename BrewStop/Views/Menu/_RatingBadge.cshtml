@model BrewStop.Models.MenuItemDto

<div class="flex items-center gap-1.5 text-xs">
    @if (Model.ReviewCount > 0)
    {
        <span class="inline-flex items-center gap-1 rounded-full bg-amber-400/15 px-2.5 py-0.5 font-semibold text-amber-300">
            <i class="fa-solid fa-star text-[10px]"></i> @Model.RatingText
        </span>
        <span class="text-neutral-400">(@Model.ReviewCount)</span>
    }
    else
    {
        <span class="text-neutral-500">No reviews yet</span>
    }
</div>