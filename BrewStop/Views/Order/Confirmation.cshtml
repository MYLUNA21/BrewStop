@model BrewStop.Models.Order
@inject BrewStop.Services.IPickupSlotService Slots
@inject BrewStop.Services.IImageResolver Images

@{
    ViewData["Title"] = "Order placed";
    ViewData["LiveReload"] = false;
    var pickupLocal = Slots.ToLocal(Model.PickupAtUtc);
    var subtotal = Model.Items.Sum(i => i.UnitPrice * i.Quantity);
}

<div class="tw">
    <div class="mx-auto max-w-3xl px-4 pt-24 pb-12">
        <div class="rounded-3xl border border-white/10 bg-card p-5 sm:p-6">
            <div class="flex items-center gap-3">
                <span class="grid size-11 place-items-center rounded-full bg-emerald-500/15 text-emerald-300"><i class="fa-solid fa-check"></i></span>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-caramel">Order placed</p>
                    <h1 class="font-serif text-2xl font-bold text-cream sm:text-3xl">Order #@Model.Id</h1>
                </div>
            </div>

            <div class="mt-6"><partial name="_Progress" model="Model" /></div>

            <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-white/10 pt-5 text-sm">
                <div>
                    <dt class="text-neutral-400">Pickup time</dt>
                    <dd class="text-cream">@pickupLocal.ToString("ddd, MMM d · h:mm tt")</dd>
                </div>
                <div>
                    <dt class="text-neutral-400">Status</dt>
                    <dd class="mt-0.5"><partial name="_StatusBadge" model="Model" /></dd>
                </div>
                <div>
                    <dt class="text-neutral-400">Payment method</dt>
                    <dd class="text-cream">@Model.PaymentMethod</dd>
                </div>
                <div>
                    <dt class="text-neutral-400">Payment status</dt>
                    <dd class="text-cream">@Model.PaymentStatus.Label()</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.PaymentReference))
                {
                    <div class="col-span-2">
                        <dt class="text-neutral-400">GCash reference</dt>
                        <dd class="font-mono text-cream">@Model.PaymentReference</dd>
                    </div>
                }
            </dl>

            <ul class="mt-5 divide-y divide-white/10 border-t border-white/10">
                @foreach (var i in Model.Items)
                {
                    <li class="flex items-start justify-between gap-4 py-3 text-sm">
                        <div class="flex min-w-0 items-start gap-3">
                            <img src="@Images.Resolve(i.MenuItem?.ImageUrl, i.ItemName)" alt="@i.ItemName" class="size-14 shrink-0 rounded-lg object-cover" />
                            <div class="min-w-0">
                                <p class="text-cream">@i.Quantity &times; @i.ItemName</p>
                                <p class="text-xs text-neutral-400">
                                    @(i.SizeName ?? "")@(i.SizeName is not null && i.AddOns.Count > 0 ? " · " : "")@string.Join(", ", i.AddOns.Select(a => a.Name))
                                </p>
                            </div>
                        </div>
                        <span class="shrink-0 text-cream">&#8369;@((i.UnitPrice * i.Quantity).ToString("N2"))</span>
                    </li>
                }
            </ul>

            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <p class="text-sm text-neutral-300"><span class="text-neutral-400">Note:</span> @Model.Note</p>
            }

            <dl class="mt-3 space-y-1 border-t border-white/10 pt-4 text-sm">
                <div class="flex justify-between text-neutral-300"><dt>Subtotal</dt><dd>&#8369;@subtotal.ToString("N2")</dd></div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="flex justify-between text-emerald-300"><dt>Promo @Model.PromoCode</dt><dd>&minus;&#8369;@Model.DiscountAmount.ToString("N2")</dd></div>
                }
                <div class="flex items-baseline justify-between pt-1">
                    <dt class="text-neutral-300">Total (pay at pickup)</dt>
                    <dd class="text-2xl font-bold text-caramel">&#8369;@Model.Total.ToString("N2")</dd>
                </div>
            </dl>

            <partial name="_Qr" />

            <div class="mt-6 flex flex-wrap gap-3">
                <a asp-action="Details" asp-route-id="@Model.Id"
                   class="rounded-full bg-caramel px-5 py-2 text-sm font-semibold text-black hover:bg-cream">Track order</a>
                <a asp-controller="Menu" asp-action="Index"
                   class="rounded-full border border-white/20 px-5 py-2 text-sm text-cream hover:border-caramel">Back to menu</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_OrderLive" />
}