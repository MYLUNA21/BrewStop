@model List<BrewStop.Models.Order>
@{
    ViewData["Title"] = "My Orders";
    var active = Model.Where(o => o.Status is OrderStatus.Placed or OrderStatus.Preparing or OrderStatus.Ready).ToList();
    var past = Model.Where(o => !active.Contains(o)).ToList();
    ViewData["LiveReload"] = false;
}

<div class="tw">
    <div class="mx-auto max-w-4xl px-4 pt-24 pb-12">
        <div class="flex items-end justify-between gap-3">
            <h1 class="font-serif text-3xl font-bold text-cream">My Orders</h1>
            <a asp-controller="Account" asp-action="Manage" class="text-sm font-semibold text-caramel hover:text-cream">My account</a>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <p class="mt-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3 text-sm text-emerald-300">@ok</p>
        }

        @if (Model.Count == 0)
        {
            <div class="mt-8 rounded-3xl border border-white/10 bg-card px-6 py-14 text-center">
                <div class="mx-auto grid size-16 place-items-center rounded-full bg-caramel/10 text-2xl text-caramel"><i class="fa-solid fa-receipt"></i></div>
                <h2 class="mt-4 font-serif text-xl font-semibold text-cream">No orders yet</h2>
                <a asp-controller="Menu" asp-action="Index"
                   class="mt-5 inline-block rounded-full bg-caramel px-8 py-3 text-sm font-semibold text-black hover:bg-cream">Browse the menu</a>
            </div>
        }
        else
        {
            @if (active.Count > 0)
            {
                <h2 class="mt-8 text-sm font-semibold uppercase tracking-wider text-caramel">Active</h2>
                <div class="mt-3 space-y-3">
                    @foreach (var o in active)
                    {
                        <partial name="_OrderCard" model="o" />
                    }
                </div>
            }
            @if (past.Count > 0)
            {
                <h2 class="mt-8 text-sm font-semibold uppercase tracking-wider text-neutral-400">History</h2>
                <div class="mt-3 space-y-3">
                    @foreach (var o in past)
                    {
                        <div>
                            <partial name="_OrderCard" model="o" />
                            <div class="mt-2 flex justify-end gap-2">
                                <a asp-action="Receipt" asp-route-id="@o.Id"
                                   class="rounded-full border border-white/15 px-4 py-1.5 text-xs font-semibold text-cream transition hover:border-caramel hover:text-caramel">
                                    <i class="fa-solid fa-receipt mr-1"></i>Receipt
                                </a>
                                <form asp-action="Reorder" asp-route-id="@o.Id" method="post">
                                    <button type="submit" class="rounded-full bg-caramel px-4 py-1.5 text-xs font-semibold text-black transition hover:bg-cream">
                                        <i class="fa-solid fa-rotate-right mr-1"></i>Reorder
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    @if (active.Count > 0)
    {
        <partial name="_OrderLive" />
    }
}