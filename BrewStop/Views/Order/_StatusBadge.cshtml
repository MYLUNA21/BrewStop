@model BrewStop.Models.Order
<span data-order-status="@Model.Id" data-status="@Model.Status"
      class="inline-flex items-center rounded-full bg-white/10 px-2.5 py-0.5 text-xs font-semibold text-neutral-300 data-[status=Placed]:bg-sky-500/15 data-[status=Placed]:text-sky-300 data-[status=Preparing]:bg-amber-500/15 data-[status=Preparing]:text-amber-300 data-[status=Ready]:bg-emerald-500/15 data-[status=Ready]:text-emerald-300 data-[status=Cancelled]:bg-red-500/15 data-[status=Cancelled]:text-red-300">@Model.Status</span>