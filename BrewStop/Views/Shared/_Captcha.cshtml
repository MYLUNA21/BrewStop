@model string
@{
    var id = "bs-cc-" + Guid.NewGuid().ToString("N")[..8];
}
<div id="@id" class="group/cc my-1" data-state="idle" data-action="@Model">

    @* Trigger checkbox (Unchanged dark theme for the main page) *@
    <label class="flex cursor-pointer select-none items-center gap-3 rounded-xl border border-stone-700 bg-stone-800/50 px-3.5 py-3 transition hover:border-amber-400
        group-data-[state=success]/cc:cursor-default group-data-[state=success]/cc:border-green-400
        group-data-[state=error]/cc:border-red-400">
        <input type="checkbox" class="bs-cc-check peer sr-only" aria-describedby="@id-status" aria-haspopup="dialog" />
        <span aria-hidden="true"
              class="grid size-6 flex-none place-items-center rounded-md border-2 border-stone-400
            peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-amber-400
            group-data-[state=success]/cc:border-green-400 group-data-[state=success]/cc:bg-green-400">
            <svg viewBox="0 0 20 20" class="hidden size-4 text-stone-950 group-data-[state=success]/cc:block" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 10.5l4 4 8-9" />
            </svg>
        </span>
        <span class="flex-1 text-sm">I am not a robot</span>
        <span class="text-xl" aria-hidden="true">&#9749;</span>
    </label>

    <p id="@id-status" class="mt-1.5 min-h-4 px-0.5 text-xs text-stone-400 group-data-[state=error]/cc:text-red-300" role="status" aria-live="polite"></p>

    <input type="hidden" name="bs-captcha-token" class="bs-cc-token" />

    @* Modal - Replaced with Starbucks/reCAPTCHA light theme *@
    <dialog class="bs-cc-dialog m-auto w-[calc(100%-2rem)] max-w-[400px] overflow-hidden rounded-sm border border-stone-300 bg-white p-0 text-stone-900 shadow-2xl backdrop:bg-black/50"
            aria-labelledby="@id-title">
        <div class="p-2">
            <div id="@id-title" class="bg-blue-600 px-5 py-4 text-white">
                <p class="text-sm leading-tight">Select all images with</p>
                <p class="text-2xl font-bold leading-tight">coffee</p>
            </div>

            <div class="bs-cc-grid mt-0.5 grid grid-cols-3 gap-0.5 bg-white" role="group" aria-labelledby="@id-title"></div>

            <p class="bs-cc-error mt-2 hidden px-1 text-sm text-red-600" role="alert">Please try again.</p>

            <div class="mt-2 flex items-center justify-between border-t border-stone-200 px-1 pt-2">
                <div class="flex items-center gap-1 text-stone-500">
                    <button type="button" class="bs-cc-refresh grid size-9 place-items-center rounded hover:bg-stone-100" aria-label="Get a new challenge">
                        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12a9 9 0 1 1-3-6.7" />
                            <path d="M21 3v6h-6" />
                        </svg>
                    </button>
                    <button type="button" class="bs-cc-cancel rounded px-2 py-1 text-xs hover:bg-stone-100">Cancel</button>
                </div>
                <button type="button" disabled
                        class="bs-cc-verify rounded-sm bg-blue-600 px-6 py-3 text-sm font-semibold uppercase text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50">
                    Verify
                </button>
            </div>
        </div>
    </dialog>

    @* Tile template - Replaced with blue checkmark styling *@
    <template class="bs-cc-tile">
        <button type="button" aria-pressed="false" aria-label="Image option"
                class="group/tile relative aspect-square overflow-hidden bg-stone-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600">
            <img alt="" draggable="false"
                 class="size-full object-cover transition-transform duration-150 group-aria-pressed/tile:scale-[0.8]" />
            <span class="pointer-events-none absolute left-1 top-1 hidden size-6 place-items-center rounded-full bg-blue-600 text-white group-aria-pressed/tile:grid">
                <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 10.5l4 4 8-9" />
                </svg>
            </span>
        </button>
    </template>
</div>

<script>
    (function() {
        const root = document.getElementById('@id');
        const form = root.closest('form');
        const base = '@Url.Content("~/captcha")';
        const action = root.dataset.action;

        const check = root.querySelector('.bs-cc-check');
        const status = root.querySelector('[role="status"]');
        const tokenInput = root.querySelector('.bs-cc-token');
        const dialog = root.querySelector('.bs-cc-dialog');
        const grid = root.querySelector('.bs-cc-grid');
        const errorEl = root.querySelector('.bs-cc-error');
        const verifyBtn = root.querySelector('.bs-cc-verify');
        const cancelBtn = root.querySelector('.bs-cc-cancel');
        const refreshBtn = root.querySelector('.bs-cc-refresh');
        const tileTpl = root.querySelector('.bs-cc-tile');

        let challengeId = null;
        let verified = false;
        let expiresAt = 0;

        function setState(state, msg) {
            root.dataset.state = state;
            status.textContent = msg || '';
        }

        function reset() {
            verified = false;
            expiresAt = 0;
            tokenInput.value = '';
            check.checked = false;
            check.disabled = false;
            setState('idle');
        }

        function openChallenge() {
            check.checked = true;
            setState('idle');
            if (!dialog.open) dialog.showModal();
            loadChallenge();
        }

        function antiforgery() {
            const el = form && form.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function selected() {
            return [...grid.querySelectorAll('[aria-pressed="true"]')];
        }

        function buildTile(t, i) {
            const node = tileTpl.content.firstElementChild.cloneNode(true);
            node.dataset.id = t.id;
            node.setAttribute('aria-label', 'Image ' + (i + 1));
            node.querySelector('img').src = t.src;
            node.addEventListener('click', function() {
                node.setAttribute('aria-pressed', node.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
                errorEl.classList.add('hidden');
                verifyBtn.disabled = selected().length === 0;
            });
            return node;
        }

        async function loadChallenge() {
            verifyBtn.disabled = true;
            errorEl.classList.add('hidden');

            // Restore grid structure in case the previous load errored out
            grid.className = 'bs-cc-grid mt-0.5 grid grid-cols-3 gap-0.5 bg-white';
            grid.setAttribute('aria-busy', 'true');

            grid.replaceChildren(...Array.from({ length: 9 }, function() {
                const s = document.createElement('div');
                s.className = 'aspect-square animate-pulse bg-stone-200';
                return s;
            }));

            try {
                const r = await fetch(base + '/challenge?action=' + encodeURIComponent(action), { cache: 'no-store' });
                if (!r.ok) throw new Error('challenge');
                const data = await r.json();
                challengeId = data.id;
                grid.replaceChildren(...data.tiles.map(buildTile));
            } catch (e) {
                challengeId = null;
                grid.textContent = 'Could not load the challenge. Close this window and try again.';
                grid.className = 'bs-cc-grid p-4 text-sm text-red-600';
            } finally {
                grid.removeAttribute('aria-busy');
            }
        }

        async function verify() {
            if (!challengeId) return;
            verifyBtn.disabled = true;
            const tiles = selected().map(function(b) { return b.dataset.id; });

            let data = { ok: false };
            try {
                const r = await fetch(base + '/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiforgery() },
                    body: JSON.stringify({ challengeId: challengeId, tiles: tiles, action: action })
                });
                if (r.ok) data = await r.json();
            } catch (e) { /* treated as failure */ }

            if (data.ok) {
                verified = true;
                expiresAt = Date.now() + Math.max(30, (data.expiresIn || 600) - 15) * 1000;
                tokenInput.value = data.token;
                check.checked = true;
                check.disabled = true;
                setState('success', 'Verified.');
                dialog.close('success');
            } else {
                await loadChallenge();
                errorEl.classList.remove('hidden');
            }
        }

        check.addEventListener('change', function() {
            if (verified) { check.checked = true; return; }
            if (check.checked) openChallenge();
        });

        dialog.addEventListener('close', function() {
            if (!verified) reset();
        });

        dialog.addEventListener('click', function(e) { if (e.target === dialog) dialog.close(); });
        cancelBtn.addEventListener('click', function() { dialog.close(); });
        refreshBtn.addEventListener('click', loadChallenge);
        verifyBtn.addEventListener('click', verify);

        form.addEventListener('submit', function(e) {
            if (verified && Date.now() < expiresAt) return;
            e.preventDefault();
            reset();
            openChallenge();
        });

        window.addEventListener('pageshow', function(e) {
            if (e.persisted) reset();
        });
    })();
</script>