@inject BrewStop.Services.ICartService Cart
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BrewStop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    

    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script>
            tailwind.config = {
                important: '.tw',
                corePlugins: { preflight: false },
                theme: { extend: { colors: { espresso: '#1a0f0d', card: '#241411', caramel: '#d4a373', cream: '#fefae0' } } }
            };
    </script>
</head>
<body>
    <!-- Elegant Glassmorphic Navbar -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3 fixed-top glass-nav">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-wrapper">
                        <i class="fa-solid fa-mug-hot"></i>
                    </div>
                    <span class="fw-bold tracking-wider font-serif">Brew<span class="text-caramel">Stop</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        <li class="nav-item">
                            <a class="nav-link text-light px-3 py-2 rounded-pill hover-effect" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-3 py-2 rounded-pill hover-effect" asp-controller="Menu" asp-action="Index">Menu</a>
                        </li>

                        <li class="nav-item ms-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a class="nav-link text-light px-3 py-2 rounded-pill hover-effect" asp-controller="Order" asp-action="Index">My Orders</a>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                        <i class="fa-solid fa-right-from-bracket me-1"></i> Logout
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="nav-link text-light px-3 py-2 rounded-pill hover-effect" asp-controller="Account" asp-action="Login">Login</a>
                            }
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light px-3 py-2 rounded-pill hover-effect" asp-controller="Home" asp-action="Privacy">About</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-caramel rounded-pill px-4 shadow-sm text-dark fw-semibold" asp-controller="Cart" asp-action="Index">
                                <i class="fa-solid fa-bag-shopping me-1"></i> Cart
                                @if (Cart.Count > 0)
                                {
                                    <span class="badge bg-dark text-caramel ms-1">@Cart.Count</span>
                                }
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <div class="main-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="tw bs-footer mt-16 border-t border-white/10 bg-card">
        <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-5">
            <div>
                <h3 class="font-serif text-base font-semibold text-cream">About Us</h3>
                <ul class="mt-4 space-y-2.5 text-sm text-neutral-400">
                    <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-caramel">Our Shop</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-caramel">Customer Service</a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-serif text-base font-semibold text-cream">Order Online</h3>
                <ul class="mt-4 space-y-2.5 text-sm text-neutral-400">
                    <li><a asp-controller="Menu" asp-action="Index" class="hover:text-caramel">Browse Menu</a></li>
                    <li><a asp-controller="Cart" asp-action="Index" class="hover:text-caramel">Your Cart</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-caramel">Pickup Slots</a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-serif text-base font-semibold text-cream">My Account</h3>
                <ul class="mt-4 space-y-2.5 text-sm text-neutral-400">
                    <li><a asp-controller="Account" asp-action="Login" class="hover:text-caramel">Sign in</a></li>
                    <li><a asp-controller="Account" asp-action="Register" class="hover:text-caramel">Join Now</a></li>
                    <li><a asp-controller="Account" asp-action="ForgotPassword" class="hover:text-caramel">Forgot password</a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-serif text-base font-semibold text-cream">Orders</h3>
                <ul class="mt-4 space-y-2.5 text-sm text-neutral-400">
                    <li><span>Order history</span></li>
                    <li><span>Pickup verification</span></li>
                </ul>
            </div>
            <div class="flex items-start lg:justify-end">
                <span class="font-serif text-2xl font-bold tracking-[0.3em] text-cream lg:[writing-mode:vertical-rl]">
                    BREW<span class="text-caramel">STOP</span>
                </span>
            </div>
        </div>
        <div class="border-t border-white/10">
            <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-xs text-neutral-500">
                <div class="flex gap-5">
                    <a asp-controller="Home" asp-action="Privacy" class="hover:text-caramel">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="Privacy" class="hover:text-caramel">Terms of Use</a>
                </div>
                <p class="text-right">
                    &copy; @DateTime.Now.Year BrewStop. Crafted with precision &amp; passion.<br />
                    UC Banilad Campus Coffee Shop Ordering &amp; Pickup System &middot; Payment is made at pickup.
                </p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>