@inject BrewStop.Services.ICartService Cart
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BrewStop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BrewStop.styles.css" asp-append-version="true" />

    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <script>
            tailwind.config = {
                important: '.tw',
                corePlugins: { preflight: false },
                theme: { extend: { colors: { espresso: '#1a0f0d', card: '#241411', caramel: '#d4a373', cream: '#fefae0' } } }
            };
    </script>
</head>
<body>
    <!-- Elegant Glassmorphic Navbar -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3 fixed-top glass-nav">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-wrapper">
                        <i class="fa-solid fa-mug-hot"></i>
                    </div>
                    <span class="fw-bold tracking-wider font-serif">Brew<span class="text-caramel">Stop</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        <li class="nav-item">
                            <a class="nav-link text-light px-3 py-2 rounded-pill hover-effect" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-3 py-2 rounded-pill hover-effect" asp-controller="Menu" asp-action="Index">Menu</a>
                        </li>

                        <li class="nav-item ms-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <span class="text-light small me-2">@User.Identity.Name</span>
                                    <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3">Logout</button>
                                </form>
                            }
                            else
                            {
                                <a class="nav-link text-light px-3 py-2 rounded-pill hover-effect" asp-controller="Account" asp-action="Login">Login</a>
                            }
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light px-3 py-2 rounded-pill hover-effect" asp-controller="Home" asp-action="Privacy">About</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-caramel rounded-pill px-4 shadow-sm text-dark fw-semibold" asp-controller="Cart" asp-action="Index">
                                <i class="fa-solid fa-bag-shopping me-1"></i> Cart
                                @if (Cart.Count > 0)
                                {
                                    <span class="badge bg-dark text-caramel ms-1">@Cart.Count</span>
                                }
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <div class="main-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>