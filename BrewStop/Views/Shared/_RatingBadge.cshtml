@model BrewStop.Models.MenuItemDto
@if (Model.ReviewCount > 0)
{
    <a asp-controller="Menu" asp-action="Details" asp-route-id="@Model.Id"
       aria-label="Rated @Model.RatingText out of 5 from @Model.ReviewCount reviews"
       class="inline-flex items-center gap-1 text-xs font-semibold text-amber-300 hover:text-amber-200">
        <span aria-hidden="true">&#9733;</span> @Model.RatingText
        <span class="font-normal text-neutral-400">(@Model.ReviewCount)</span>
    </a>
}
else
{
    <a asp-controller="Menu" asp-action="Details" asp-route-id="@Model.Id"
       class="text-xs text-neutral-500 hover:text-caramel">No reviews yet</a>
}